                <td>${r.plannedHours ? Number(r.plannedHours).toLocaleString('ru-RU') + ' ч.' : '—'}</td>
                <td>${resourceEscape(r.comment || '—')}</td>
                <td style="font-size:11px;color:#6B7280">${resourceEscape(r.updatedBy || '—')}<br>${resourceFormatDate(r.updatedAt)}</td>
            </tr>
        `).join('');
    } catch (e) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#EF4444;padding:20px">Ошибка: ' + resourceEscape(e.message) + '</td></tr>';
    }
