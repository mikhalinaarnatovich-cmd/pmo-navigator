function dashRenderDeptChart() {
    // Reuse the existing pkRenderDeptChart but on dashChartDept canvas
    const INACTIVE = ["Завершён","Отменён"];
    const active = allProjects.filter(p => !INACTIVE.includes(p.status));
    const deptMap = {};
    active.forEach(p => {
        const d = p.department && p.department !== "-" ? p.department : "Не указан";
        if (!deptMap[d]) deptMap[d] = { total: 0, red: 0, yellow: 0, green: 0 };
        deptMap[d].total++;
        const rag = getPKStatus(p);
        if (rag === "red") deptMap[d].red++;
        else if (rag === "yellow") deptMap[d].yellow++;
        else deptMap[d].green++;
    });
    const depts = Object.entries(deptMap).sort((a,b) => b[1].total - a[1].total);
    const canvas = document.getElementById("dashChartDept");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    ctx.clearRect(0,0,canvas.width,canvas.height);
    if (depts.length === 0) return;
    const maxVal = Math.max(...depts.map(([,d]) => d.total));
    const barH = 28, gap = 6, leftPad = 160, rightPad = 80;
    const chartH = depts.length * (barH + gap);
    canvas.height = chartH + 20;
    const cw = canvas.width;
    depts.forEach((([dept, d], i) => {
        const y = i * (barH + gap) + 10;
        ctx.fillStyle = "#374151";
        ctx.font = "11px sans-serif";
        ctx.textAlign = "right";
        ctx.fillText(dept.length > 25 ? dept.slice(0,25) + "..." : dept, leftPad - 8, y + barH/2 + 4);
        const barW = cw - leftPad - rightPad;
        const segTotal = d.total;
        let xOff = leftPad;
        const segs = [
            { v: d.red,    c: "#EF4444" },
            { v: d.yellow, c: "#F59E0B" },
            { v: d.green,  c: "#10B981" },
        ];
        segs.forEach(s => {
            if (s.v === 0) return;
            const w = (s.v / maxVal) * barW;
            ctx.fillStyle = s.c;
            ctx.fillRect(xOff, y, w, barH - 2);
            if (s.v > 0 && w > 20) {
                ctx.fillStyle = "#fff";
                ctx.font = "bold 10px sans-serif";
                ctx.textAlign = "center";
                ctx.fillText(s.v, xOff + w/2, y + barH/2 + 3);
            }
            xOff += w;
        });
        ctx.fillStyle = "#374151";
        ctx.font = "11px sans-serif";
        ctx.textAlign = "left";
        ctx.fillText(d.total, xOff + 6, y + barH/2 + 4);
    }));
}

function dashRenderScoringChart() {
    // Матрица как в Qlik ПК: X = Итоговый балл (взвешенный 0–5),
    // Y = Стратегическая важность (Низкая=1/Средняя=2/Высокая=3),
    // размер пузыря = Сложность и Риски (1–3). Операционная деятельность исключена.
    const active = allProjects.filter(p =>
        !["Завершён","Отменён"].includes(p.status) &&
        (p.processType || "") !== "Операционная деятельность");
    const canvas = document.getElementById("dashChartScoring");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0,0,W,H);

    const level = s => {
        const v = (s || "").toLowerCase();
        return v.includes("высок") ? 3 : v.includes("сред") ? 2 : v.includes("низк") ? 1 : null;
    };
    const num = s => {
        const v = parseFloat((s || "").replace(",", "."));
        return isNaN(v) ? null : v;
    };

    const points = active.map(p => ({
        id: p.projectId,
        x: num(p.totalScore),
        y: level(p.strategicImportance),
        c: level(p.complexityRisk),
        rag: getPKStatus(p),
    })).filter(pt => pt.x !== null && pt.y !== null);

    const L = 46, R = 14, T = 16, B = 34;
    const plotW = W - L - R, plotH = H - T - B;
    const xPos = v => L + (Math.max(0, Math.min(5, v)) / 5) * plotW;
    const yPos = v => T + ((3 - v) / 2) * (plotH - 36) + 18;

    // Сетка и шкала X (Итоговый балл 0–5)
    ctx.strokeStyle = "#E5E7EB"; ctx.lineWidth = 1; ctx.setLineDash([4,4]);
    ctx.fillStyle = "#6B7280"; ctx.font = "10px sans-serif"; ctx.textAlign = "center";
    for (let i = 0; i <= 5; i++) {
        const x = xPos(i);
        ctx.beginPath(); ctx.moveTo(x, T); ctx.lineTo(x, H - B); ctx.stroke();
        ctx.fillText(String(i), x, H - B + 13);
    }
    ctx.setLineDash([]);
    ctx.fillText("Итоговый балл", L + plotW / 2, H - 3);

    // Подписи Y (Стратегическая важность)
    ctx.textAlign = "left"; ctx.font = "9px sans-serif";
    ctx.fillText("Высокая", 2, yPos(3) + 3);
    ctx.fillText("Средняя", 2, yPos(2) + 3);
    ctx.fillText("Низкая",  2, yPos(1) + 3);

    if (points.length === 0) {
        ctx.fillStyle = "#9CA3AF"; ctx.font = "13px sans-serif"; ctx.textAlign = "center";
        ctx.fillText("Нет данных по скорингу", W / 2, H / 2);
        return;
    }

    // Пузыри: радиус по Сложности и Риски, цвет по здоровью проекта
    points.forEach(pt => {
        const jx = (pt.id * 37) % 13 - 6;   // детерминированный джиттер против наложения
        const jy = (pt.id * 53) % 9 - 4;
        const x = xPos(pt.x) + jx;
        const y = yPos(pt.y) + jy;
        const r = 4 + ((pt.c || 2) - 1) * 2;   // Низкая=4, Средняя=6, Высокая=8
        ctx.beginPath();
        ctx.globalAlpha = 0.85;
        ctx.fillStyle = pt.rag === "red" ? "#EF4444" : pt.rag === "yellow" ? "#F59E0B" : "#10B981";
        ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
        ctx.fillStyle = "#374151"; ctx.font = "8px sans-serif"; ctx.textAlign = "center";
        ctx.fillText("#" + pt.id, x, y - r - 3);
    });
}

