async function resourceSetLock(isOpen) {
    const period = resourceMonthToApiValue();
    if (!period) { resourceShowMessage('Выберите месяц.', 'error'); return; }

    const groupType = document.getElementById('resourceLockGroup').value;
    const groupValue = document.getElementById('resourceLockValue').value;
    const groupValues = [groupValue];

    try {
        const res = await fetch(resourceApiUrl('/locks'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                periodStart: period,
                groupType: groupType,
                groupValues: groupValues,
                isOpen: isOpen
            })
        });

        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            resourceShowMessage(err.message || 'Не удалось изменить блокировку.', 'error');
