<!-- ════ СПРАВКА ════════════════════════════════════════════════════════════ -->
<div class="modal-backdrop hidden" id="helpModal">
  <div class="modal-box">
    <div class="modal-head">
      <div class="modal-head-title">PMO Навигатор — справка</div>
      <button class="modal-head-close"
        onclick="document.getElementById('helpModal').classList.add('hidden')">&times;</button>
    </div>
    <div class="modal-body">

      <div class="help-section">
        <div class="help-section-title">Что это такое</div>
        <p>Навигатор по портфелю проектов PMO. Позволяет быстро найти нужный проект,
        увидеть его статус, команду, сроки и документы — без входа в Service Desk
        и без лицензии Qlik. Данные автоматически загружаются из CSV-выгрузки.</p>
      </div>

      <div class="help-section">
        <div class="help-section-title">Список проектов</div>
        <ul>
          <li><b>Фильтр по статусу</b> — в левой панели. Цифра рядом — количество проектов.</li>
          <li><b>Поиск</b> — по названию, ID, заказчику, руководителю проекта или отделу.</li>
          <li><b>Клик на строку</b> — открывает карточку проекта справа.</li>
        </ul>
      </div>

      <div class="help-section">
        <div class="help-section-title">Вкладка «Портфель»</div>
        <ul>
          <li><b>Диаграмма Ганта</b> по всем проектам портфеля на одном экране.</li>
          <li><b>Фильтры</b>: статус, отдел, приоритет, заказчик, руководитель проекта.</li>
          <li><b>Только активные</b> — скрывает завершённые и отменённые проекты.</li>
          <li><b>Масштаб</b>: Квартал (3 мес), Полугодие (6 мес), Год (12 мес), <b>Весь портфель</b> (все даты из CSV).</li>
          <li><b>Красная вертикальная линия</b> — сегодняшняя дата.</li>
          <li><b>Красные полосы</b> — просроченные проекты (план. окончание в прошлом, статус не «Завершён»/«Отменён»).</li>
          <li><b>Клик на строку</b> — открывает карточку проекта.</li>
        </ul>
      </div>

      <div class="help-section">
        <div class="help-section-title">Вкладка «ПК»</div>
        <ul>
          <li><b>Таблица Проектного Комитета</b> — активные проекты с RAG-статусом.</li>
          <li><b>Красный</b> — срок завершения уже прошёл.</li>
          <li><b>Жёлтый</b> — срок завершается в течение 30 дней.</li>
          <li><b>Зелёный</b> — срок не критичный.</li>
          <li><b>Клик на строку</b> — открывает карточку проекта.</li>
          <li><b>Комментарий</b> — кликните на ячейку комментария, введите текст и нажмите «Сохранить».</li>
        </ul>
      </div>

      <div class="help-section">
        <div class="help-section-title">Карточка проекта — вкладки</div>
        <table class="help-table">
          <tr><td>Команда</td><td>Все участники проекта с указанием роли (куратор, РП, заказчик и др.)</td></tr>
          <tr><td>Документы</td><td>Файлы из сетевой папки проекта. Кликните на файл — откроется в программе.</td></tr>
          <tr><td>Ганта</td><td>Визуальная шкала плановых и фактических сроков. Красная линия — сегодня.</td></tr>
          <tr><td>Ссылки</td><td>Прямая ссылка на проект в Service Desk.</td></tr>
        </table>
      </div>

      <div class="help-section">
        <div class="help-section-title">Цветовые обозначения статусов</div>
        <table class="help-table">
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#22c55e;margin-right:6px"></span>Выполнение и контроль</td><td>Проект активно выполняется</td></tr>
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#eab308;margin-right:6px"></span>На паузе</td><td>Работы временно приостановлены</td></tr>
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#a855f7;margin-right:6px"></span>Инициация / Планирование</td><td>Проект в начальной стадии</td></tr>
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#3b82f6;margin-right:6px"></span>Завершение / В бэклоге</td><td>Финальная стадия или ожидание старта</td></tr>
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#9ca3af;border:1px solid #d1d5db;margin-right:6px"></span>Завершён</td><td>Проект закрыт</td></tr>
          <tr><td><span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#ef4444;margin-right:6px"></span>Отменён</td><td>Проект прекращён</td></tr>
        </table>
      </div>

      <div class="help-section">
        <div class="help-section-title">Обновление данных</div>
        <p>Кнопка <b>Обновить</b> в правом верхнем углу перечитывает файлы
        <code>projects.csv</code> и <code>members.csv</code> из папки
        <code>wwwroot/data/</code> без перезапуска приложения.
        Нажимайте после того как выгрузили свежие данные из Qlik или вручную обновили CSV.</p>
      </div>

    </div>
    <div class="modal-foot">
      <button onclick="document.getElementById('helpModal').classList.add('hidden')">Понятно</button>
    </div>
  </div>
</div>

<script>
const BASE = window.location.pathname.startsWith('/pmo') ? '/pmo' : '';
// ════ СОСТОЯНИЕ ═════════════════════════════════════════════════════════════
let currentStatus = 'Все';
let currentSearch = '';
let selectedId    = null;
let allProjects   = [];
let statusCounts  = {};
let portfolioScale = 'half'; // 'quarter' | 'half' | 'year'
let portfolioViewActive = false;
let pkViewActive = false;
let crViewActive = false;
let dashboardViewActive = false;
let pkComments = {}; // { projectId: "comment text" }
let pkSortField = 'rag';  // 'rag' | 'name' | 'score'
let pkSortDir   = 'desc'; // для скоринга по умолчанию — высокий вверху
let tbFilters = { dept: '', priority: '', pm: '', customer: '', curator: '' };
let sortField = 'projectId';
let sortAsc   = true;

// ════ ИНИЦИАЛИЗАЦИЯ ══════════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', async () => {
    animateProgress(0, 30, 400);
    await loadProjects();
    animateProgress(30, 100, 300);
    setTimeout(() => {
        document.getElementById('loadingOverlay').classList.add('hidden');
    }, 400);

    let searchTimer;
    // Debounce for PK search
    let pkSearchTimer;
    document.getElementById('pkSearch')?.addEventListener('input', e => {
        clearTimeout(pkSearchTimer);
        pkSearchTimer = setTimeout(() => renderPKTable(), 250);
    });

    document.getElementById('searchInput').addEventListener('input', e => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            currentSearch = e.target.value.trim();
            renderTable();
        }, 200);
    });

    document.querySelectorAll('.dtab').forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.dataset.tab;
            document.querySelectorAll('.dtab').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
            document.querySelectorAll('.dtab-content').forEach(c => c.classList.toggle('active', c.id === 'tab-' + tab));
        });
    });

    // Сортировка по клику на заголовок
    document.querySelectorAll('.projects-table th[data-sort]').forEach(th => {
        th.addEventListener('click', () => {
            const field = th.dataset.sort;
            if (sortField === field) sortAsc = !sortAsc;
            else { sortField = field; sortAsc = true; }
            document.querySelectorAll('.projects-table th').forEach(t => t.classList.remove('sort-asc','sort-desc'));
            th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
            renderTable();
        });
    });
    // Подсветить начальную колонку
    const initTh = document.querySelector('.projects-table th[data-sort="projectId"]');
    if (initTh) initTh.classList.add('sort-asc');

    // Закрытие справки по клику на фон
    document.getElementById('helpModal').addEventListener('click', function(e) {
        if (e.target === this) this.classList.add('hidden');
    });
});

function animateProgress(from, to, ms) {
    const bar = document.getElementById('progressBar');
    const step = (to - from) / (ms / 16);
    let cur = from;
    const t = setInterval(() => {
        cur = Math.min(cur + step, to);
        bar.style.width = cur + '%';
        if (cur >= to) clearInterval(t);
    }, 16);
}

// ════ ЗАГРУЗКА ДАННЫХ ════════════════════════════════════════════════════════
async function loadProjects() {
    try {
        const res = await fetch(BASE+'/api/projects?status=Все');
        const data = await res.json();
        allProjects = data.items || [];
        buildStatusCounts();
        renderSidebar();
        renderTable();
        buildPortfolioSelects();
        buildToolbarSelects();
        await loadPKComments();
    } catch (e) {
        console.error('Ошибка загрузки:', e);
    }
}

async function reloadData() {
    const btn = document.getElementById('btnReload');
    btn.classList.add('loading');
    try {
        await fetch(BASE+'/api/projects/reload', { method: 'POST' });
        await loadProjects();
        if (selectedId) loadDetail(selectedId);
        if (portfolioViewActive) renderPortfolioGantt();
        if (pkViewActive) { renderPKTable(); updatePKCounters(); updatePKCharts(); }
        if (dashboardViewActive) { updateDashboardCounters(); updateDashboardCharts(); }
        if (crViewActive) renderCRTable();
    } finally {
        btn.classList.remove('loading');
    }
}

// ════ СЧЁТЧИКИ СТАТУСОВ ══════════════════════════════════════════════════════
function buildStatusCounts() {
    statusCounts = { 'Все': allProjects.length };
    for (const p of allProjects) {
        statusCounts[p.status] = (statusCounts[p.status] || 0) + 1;
    }
}

// ════ SIDEBAR ════════════════════════════════════════════════════════════════
const STATUS_ORDER = [
    'Все','Выполнение и контроль','Инициация','Планирование',
    'На паузе (On-Hold)','Завершение','Утвержден (В бэклоге)',
    'Отложен','Завершён','Отменён',
];

function renderSidebar() {
    const list = document.getElementById('statusList');
    list.innerHTML = '';
    const statuses = STATUS_ORDER.filter(s => s === 'Все' || statusCounts[s]);
    for (const s of Object.keys(statusCounts)) {
        if (!STATUS_ORDER.includes(s)) statuses.push(s);
    }
    for (const s of statuses) {
        if (!statusCounts[s] && s !== 'Все') continue;
        const btn = document.createElement('button');
        btn.className = 'status-btn' + (currentStatus === s ? ' active' : '');
        btn.innerHTML = `<span class="label">${s}</span><span class="cnt">${statusCounts[s] || 0}</span>`;
        btn.onclick = () => {
            currentStatus = s;
            document.querySelectorAll('.status-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderTable();
        };
        list.appendChild(btn);
        if (s === 'Все') {
            const sep = document.createElement('div');
            sep.className = 'sidebar-sep';
            list.appendChild(sep);
        }
    }
}

// ════ ТАБЛИЦА ════════════════════════════════════════════════════════════════
function filtered() {
    let list = allProjects;
    if (currentStatus !== 'Все') list = list.filter(p => p.status === currentStatus);
    if (tbFilters.dept)     list = list.filter(p => p.department     === tbFilters.dept);
    if (tbFilters.priority) list = list.filter(p => p.priority       === tbFilters.priority);
    if (tbFilters.pm)       list = list.filter(p => p.projectManager === tbFilters.pm);
    if (tbFilters.customer) list = list.filter(p => p.customer       === tbFilters.customer);
    if (tbFilters.curator)  list = list.filter(p => p.curator        === tbFilters.curator);
    if (currentSearch) {
        const q = currentSearch.toLowerCase();
        list = list.filter(p =>
            p.name.toLowerCase().includes(q) ||
            String(p.projectId).includes(q) ||
            (p.customer || '').toLowerCase().includes(q) ||
            (p.projectManager || '').toLowerCase().includes(q) ||
            (p.department || '').toLowerCase().includes(q)
        );
    }
    // Сортировка
    list = list.slice().sort((a, b) => {
        let va = a[sortField] ?? '';
        let vb = b[sortField] ?? '';
        if (sortField === 'projectId') { va = Number(va); vb = Number(vb); }
        else if (sortField === 'planEnd' || sortField === 'planStart') {
            va = va && va !== '-' ? new Date(va).getTime() : 0;
            vb = vb && vb !== '-' ? new Date(vb).getTime() : 0;
        } else {
            va = String(va).toLowerCase();
            vb = String(vb).toLowerCase();
        }
        if (va < vb) return sortAsc ? -1 : 1;
        if (va > vb) return sortAsc ? 1 : -1;
        return 0;
    });
    return list;
}

function renderTable() {
    const list = filtered();
    const tbody = document.getElementById('projectsTbody');
    document.getElementById('toolbarInfo').textContent =
        `Проектов: ${list.length}${allProjects.length !== list.length ? ' из ' + allProjects.length : ''}`;

    if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7"
          style="text-align:center;padding:40px;color:#9CA3AF">Проектов не найдено</td></tr>`;
        return;
    }

    const MAX_ROWS = 150;
    const visible = list.slice(0, MAX_ROWS);
    const todayMs = new Date().setHours(0,0,0,0);
    tbody.innerHTML = visible.map(p => {
        const isOverdueRow = p.planEnd && p.planEnd !== '-'
            && new Date(p.planEnd).getTime() < todayMs
            && p.status !== 'Завершён' && p.status !== 'Отменён';
        const rowClass = [
            selectedId === p.projectId ? 'selected' : '',
            isOverdueRow ? 'row-overdue' : ''
        ].filter(Boolean).join(' ');
        return `
      <tr onclick="loadDetail(${p.projectId})" class="${rowClass}">
        <td class="col-id">${p.projectId}</td>
        <td class="col-name">
          <div class="p-name">${esc(p.name)}</div>
          ${p.department ? `<div class="p-dept">${esc(p.department)}</div>` : ''}
        </td>
        <td class="col-cust">
          <div>${esc(p.customer || '—')}</div>
          ${p.curator && p.curator !== '-' ? `<div class="p-dept">${esc(p.curator)}</div>` : ''}
        </td>
        <td class="col-pm">${esc(p.projectManager || '—')}</td>
        <td class="col-dates">${formatDateRange(p.planStart, p.planEnd)}</td>
        <td>${statusBadge(p.status)}</td>
        <td class="col-prio">${priorityHtml(p.priority)}</td>
      </tr>`;
    }).join('');
    if (list.length > MAX_ROWS) {
        tbody.innerHTML += `<tr><td colspan="7" style="text-align:center;padding:12px;color:#9CA3AF;font-size:12px">Показано ${MAX_ROWS} из ${list.length}. Уточните поиск, чтобы увидеть остальные.</td></tr>`;
    }
}

// ════ КАРТОЧКА ПРОЕКТА ═══════════════════════════════════════════════════════
async function loadDetail(id) {
    selectedId = id;
    // Переключиться на основной вид если открыт портфель или ПК
    if (portfolioViewActive) showMain();
    if (pkViewActive) showMain();
    renderTable();

    document.querySelectorAll('.dtab').forEach(b => b.classList.toggle('active', b.dataset.tab === 'members'));
    document.querySelectorAll('.dtab-content').forEach(c => c.classList.toggle('active', c.id === 'tab-members'));
    document.getElementById('detailPanel').classList.add('open');

    try {
        const res = await fetch(BASE+`/api/projects/${id}`);
        const p   = await res.json();

        document.getElementById('dId').textContent       = `Проект № ${p.projectId}`;
        document.getElementById('dName').textContent     = p.name;
        document.getElementById('dStatus').innerHTML     = statusBadge(p.status);
        document.getElementById('dPriority').innerHTML   = priorityHtml(p.priority);
        document.getElementById('dCustomer').textContent = p.customer || '—';
        document.getElementById('dPM').textContent       = p.projectManager || '—';
        document.getElementById('dPlanStart').textContent= fmtDate(p.planStart);
        document.getElementById('dPlanEnd').textContent  = fmtDate(p.planEnd);
        document.getElementById('dFactStart').textContent= fmtDate(p.factStart);
        document.getElementById('dFactEnd').textContent  = fmtDate(p.factEnd);
        document.getElementById('dDept').textContent     = p.department || '—';
        document.getElementById('dType').textContent     = p.typeProject || '—';
        document.getElementById('dCurator').textContent      = p.curator || '—';
        document.getElementById('dStrategic').textContent    = p.strategicImportance || '—';
        const scoreVal = parseFloat(p.totalScore);
        if (!isNaN(scoreVal)) {
            const scoreCls = scoreVal >= 3 ? 'score-high' : scoreVal >= 2 ? 'score-mid' : 'score-low';
            document.getElementById('dScore').innerHTML = `<span class="score-badge ${scoreCls}">${p.totalScore}</span>`;
        } else {
            document.getElementById('dScore').textContent = '—';
        }
        document.getElementById('dHardDeadline').textContent = p.hardDeadline && p.hardDeadline !== '-'
            ? (p.hardDeadline + (p.deadlineDate && p.deadlineDate !== '-' ? ' — ' + fmtDate(p.deadlineDate) : ''))
            : '—';

        const goal = (p.goal || '').trim();
        document.getElementById('dGoalSection').style.display = goal ? '' : 'none';
        document.getElementById('dGoal').textContent = goal;

        // Команда
        const mList = document.getElementById('membersList');
        mList.innerHTML = p.members && p.members.length > 0
            ? p.members.map(m => `
                <div class="member-row">
                  <div class="member-avatar">${initials(m.person)}</div>
                  <div class="member-info">
                    <div class="member-name">${esc(m.person)}</div>
                    <div class="member-role">${esc(m.role)}</div>
                  </div>
                </div>`).join('')
            : '<div class="doc-empty">Участники не указаны</div>';

        // Документы
        const dList = document.getElementById('docsList');
        // Путь проекта в заголовке
        const projPath = `${p.projectId}_${esc(p.name)}`;
        const pathHtml = `<div style="font-size:11px;color:#9CA3AF;margin-bottom:10px;display:flex;align-items:center;gap:6px">
          <span style="font-size:14px">📂</span>
          <span style="font-weight:600;color:#6B7280">${projPath}</span>
        </div>`;
        if (p.folders && p.folders.length > 0) {
            const foldersHtml = p.folders.map(folder => {
                const cnt = (folder.files || []).length;
                const cntCls = cnt > 0 ? 'has-files' : 'no-files';
                const filesHtml = cnt > 0
                    ? folder.files.map(d => `
                        <div class="doc-row" style="display:flex;align-items:center;gap:8px">
                          <div class="doc-icon ${esc(d.ext)}" style="cursor:pointer" onclick="openFile('${esc(d.path)}')">${esc(d.ext.toUpperCase().slice(0,4))}</div>
                          <div class="doc-name" title="${esc(d.name)}" style="cursor:pointer;flex:1" onclick="openFile('${esc(d.path)}')">${esc(d.name)}</div>
                          <span class="resource-preview-btn" onclick="event.stopPropagation();openFile('${esc(d.path)}')">👁</span>
                          <a href="${BASE}/api/file/download?path=${encodeURIComponent(d.path)}" target="_blank"
                             style="font-size:11px;color:#2563EB;text-decoration:none" onclick="event.stopPropagation()">⬇</a>
                          <div class="doc-date">${d.modified}</div>
                        </div>`).join('')
                    : '<div style="font-size:12px;color:#9CA3AF;text-align:center;padding:10px">Документов нет</div>';
                return `<div class="doc-folder-group">
                  <div class="doc-folder-header">
                    <span class="doc-folder-icon">📁</span>
                    <span class="doc-folder-title">${esc(folder.name)}</span>
                    <span class="doc-folder-cnt ${cntCls}">${cnt}</span>
                  </div>
                  <div class="doc-folder-body">${filesHtml}</div>
                </div>`;
            }).join('');
            dList.innerHTML = pathHtml + foldersHtml;
        } else {
            dList.innerHTML = '<div class="doc-empty">Папка проекта недоступна или пуста.<br>Убедитесь, что сетевой диск подключён.</div>';
        }

        // Полнота документов
        renderCompleteness(p);

        // Ссылки
        const lList = document.getElementById('linksList');
        lList.innerHTML = p.projectUrl && p.projectUrl !== '-' && p.projectUrl.startsWith('http')
            ? `<a href="${esc(p.projectUrl)}" target="_blank" class="sd-link">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                Открыть в Service Desk
              </a>`
            : '<div class="doc-empty">Ссылок нет</div>';

        // Ганта
        renderGantt(p);

    } catch (e) {
        console.error('Ошибка загрузки карточки:', e);
    }
}

