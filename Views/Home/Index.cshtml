function renderCompleteness(p) {
    const el = document.getElementById('completenessList');
    const existingFolders = (p.folders || []).map(f => (f.name || '').toLowerCase());
    const getFiles = (folderName) => {
        const f = (p.folders || []).find(f => f.name === folderName);
        return f ? (f.files || []).map(fi => fi.name.toLowerCase()) : [];
    };

    // Проверяем наличие папок
    let totalRequired = 0, totalPresent = 0;
    const sectionsHtml = DOC_REQUIREMENTS.map(req => {
        const folderExists = existingFolders.some(fn =>
            fn.includes(req.folder.toLowerCase()) || req.folder.toLowerCase().includes(fn.split('.')[fn.split('.').length-1]?.trim() || ''));
        const files = getFiles(req.folder);
        const itemsHtml = req.required.map(docName => {
            // Проверяем частичное совпадение по ключевым словам
            const keyword = docName.split(' ').filter(w => w.length > 3)[0]?.toLowerCase() || docName.toLowerCase();
            const found = files.some(fn => fn.includes(keyword));
            totalRequired++;
            if (found) totalPresent++;
            return `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #F3F4F6">
              <span style="font-size:14px;flex-shrink:0">${found ? '✅' : '❌'}</span>
              <span style="font-size:12px;color:${found ? '#374151' : '#DC2626'}">${docName}</span>
            </div>`;
        }).join('');
        const cnt = files.length;
        const folderColor = cnt > 0 ? '#FFFBEB' : '#FFF5F5';
        const folderBorder = cnt > 0 ? '#FDE68A' : '#FECACA';
        return `<div style="margin-bottom:10px;border:1px solid ${folderBorder};border-radius:10px;overflow:hidden">
          <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:${folderColor}">
            <span style="font-size:15px">${folderExists || cnt > 0 ? '📁' : '📂'}</span>
            <span style="font-size:13px;font-weight:600;color:#374151;flex:1">${req.folder}</span>
            <span style="font-size:11px;padding:1px 8px;border-radius:10px;font-weight:600;
              background:${cnt > 0 ? '#DBEAFE' : '#FEE2E2'};color:${cnt > 0 ? '#1D4ED8' : '#DC2626'}">${cnt} файл</span>
          </div>
          <div style="padding:4px 12px 8px">${itemsHtml}</div>
        </div>`;
    }).join('');

    const pct = totalRequired > 0 ? Math.round(totalPresent / totalRequired * 100) : 0;
    const barColor = pct >= 80 ? '#059669' : pct >= 50 ? '#D97706' : '#DC2626';
    const summaryHtml = `<div style="margin-bottom:12px;padding:10px 14px;background:#F9FAFB;
      border:1px solid #E5E7EB;border-radius:10px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
        <span style="font-size:12px;font-weight:600;color:#374151">Полнота документации</span>
        <span style="font-size:13px;font-weight:700;color:${barColor}">${pct}%</span>
      </div>
      <div style="height:6px;background:#E5E7EB;border-radius:3px;overflow:hidden">
        <div style="height:100%;width:${pct}%;background:${barColor};border-radius:3px;transition:width .4s"></div>
      </div>
      <div style="font-size:11px;color:#9CA3AF;margin-top:4px">${totalPresent} из ${totalRequired} обязательных документов найдено</div>
    </div>`;

    el.innerHTML = summaryHtml + sectionsHtml;
}

