function buildToolbarSelects() {
    function fill(id, values) {
        const sel = document.getElementById(id);
        const sorted = [...new Set(values.filter(v => v && v !== '-'))].sort((a,b) => a.localeCompare(b,'ru'));
        sorted.forEach(v => { const o = document.createElement('option'); o.value = o.textContent = v; sel.appendChild(o); });
    }
    fill('tbDept',     allProjects.map(p => p.department));
    fill('tbPriority', allProjects.map(p => p.priority));
    fill('tbPM',       allProjects.map(p => p.projectManager));
    fill('tbCustomer', allProjects.map(p => p.customer));
    fill('tbCurator',  allProjects.map(p => p.curator));
}

function applyToolbarFilters() {
    tbFilters.dept     = document.getElementById('tbDept').value;
    tbFilters.priority = document.getElementById('tbPriority').value;
    tbFilters.pm       = document.getElementById('tbPM').value;
    tbFilters.customer = document.getElementById('tbCustomer').value;
    tbFilters.curator  = document.getElementById('tbCurator').value;
