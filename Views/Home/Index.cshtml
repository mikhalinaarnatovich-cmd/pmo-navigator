function resourceFormatMonth(value) {
    if (!value) {
        return "—";
    }

    const source = String(value).slice(0, 7);

    const date = new Date(`${source}-01T00:00:00`);

    if (Number.isNaN(date.getTime())) {
        return source;
    }

    return date.toLocaleDateString("ru-RU", {
        month: "long",
        year: "numeric"
    });
}

function resourceAnalyticsEscape(value) {
    return resourceEscape(value);
}

function resourceRenderAnalytics(data) {
    const items = data.items || [];
    const employees = data.employees || [];
    const projects = data.projects || [];
    const months = data.months || [];

    const totalPercent = items.reduce(
        (sum, item) => sum + Number(item.allocationPercent || 0),
        0
    );

    document.getElementById("analyticsItemsCount").textContent =
        items.length.toLocaleString("ru-RU");

    document.getElementById("analyticsEmployeesCount").textContent =
        employees.length.toLocaleString("ru-RU");

    document.getElementById("analyticsProjectsCount").textContent =
        projects.length.toLocaleString("ru-RU");

    document.getElementById("analyticsTotalPercent").textContent =
        `${totalPercent.toLocaleString("ru-RU", {
            maximumFractionDigits: 2
        })}%`;

    const projectsTbody = document.getElementById("analyticsProjectsTbody");

    projectsTbody.innerHTML = projects.length
        ? projects.map(project => `
            <tr>
                <td title="${resourceAnalyticsEscape(project.projectName)}">
                    ${resourceAnalyticsEscape(project.projectName)}
                </td>
                <td>${Number(project.employeesCount || 0).toLocaleString("ru-RU")}</td>
                <td>${Number(project.totalPercent || 0).toLocaleString("ru-RU", {
                    maximumFractionDigits: 2
                })}%</td>
            </tr>
        `).join("")
        : `
            <tr>
                <td colspan="3" class="resource-analytics-empty">
                    За выбранный период назначений нет.
                </td>
            </tr>
        `;

    const employeesTbody = document.getElementById("analyticsEmployeesTbody");

    employeesTbody.innerHTML = employees.length
        ? employees.map(employee => `
            <tr>
                <td>${resourceAnalyticsEscape(employee.employeeName)}</td>
                <td>${Number(employee.projectsCount || 0).toLocaleString("ru-RU")}</td>
                <td>${Number(employee.totalPercent || 0).toLocaleString("ru-RU", {
                    maximumFractionDigits: 2
                })}%</td>
            </tr>
        `).join("")
        : `
            <tr>
                <td colspan="3" class="resource-analytics-empty">
                    За выбранный период назначений нет.
                </td>
            </tr>
        `;

    const monthsTbody = document.getElementById("analyticsMonthsTbody");

    monthsTbody.innerHTML = months.length
        ? months.map(month => `
            <tr>
                <td>${resourceFormatMonth(month.period)}</td>
                <td>${Number(month.employeesCount || 0).toLocaleString("ru-RU")}</td>
                <td>${Number(month.projectsCount || 0).toLocaleString("ru-RU")}</td>
                <td>${Number(month.totalPercent || 0).toLocaleString("ru-RU", {
                    maximumFractionDigits: 2
                })}%</td>
            </tr>
        `).join("")
        : `
            <tr>
                <td colspan="4" class="resource-analytics-empty">
                    За выбранный период назначений нет.
                </td>
            </tr>
        `;
}

async function resourceLoadAnalytics() {
    const range = resourceGetAnalyticsMonthRange();

    if (!range.from || !range.to) {
        resourceShowMessage("Укажите период аналитики.", "error");
        return;
    }

    const button = document.getElementById("btnResourceAnalyticsLoad");

    button.disabled = true;
    button.textContent = "Загрузка...";

    try {
        const response = await fetch(
            resourceApiUrl(
                `analytics?from=${encodeURIComponent(range.from)}&to=${encodeURIComponent(range.to)}`
            )
        );

        if (!response.ok) {
            throw new Error("Не удалось получить аналитику.");
        }

        const data = await response.json();

        resourceRenderAnalytics(data);
    }
    catch (error) {
        console.error(error);
        resourceShowMessage(
            error.message || "Ошибка загрузки аналитики.",
            "error"
        );
    }
    finally {
        button.disabled = false;
        button.textContent = "Обновить";
    }
}

function resourceToggleAnalytics() {
    const panel = document.getElementById("resourceAnalytics");

    panel.classList.toggle("open");

    if (panel.classList.contains("open")) {
        resourceLoadAnalytics();
    }
}

document.getElementById("btnResourceOnlyEmpty")
    .addEventListener("click", resourceToggleOnlyEmpty);

document.getElementById("btnResourceCsv")
    .addEventListener("click", resourceDownloadCsv);

document.getElementById("btnResourceExcel")
    .addEventListener("click", resourceDownloadExcel);

document.getElementById("btnResourceAnalytics")
    .addEventListener("click", resourceToggleAnalytics);

document.getElementById("btnResourceAnalyticsLoad")
    .addEventListener("click", resourceLoadAnalytics);
</script>

