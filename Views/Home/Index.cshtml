async function loadPKComments() {
    try {
        const res = await fetch(BASE+'/api/projects/pk-comments');
        if (res.ok) {
            pkComments = await res.json();
        }
    } catch (e) {
        console.warn('Не удалось загрузить комментарии ПК:', e);
        pkComments = {};
    }
}

async function savePKComment(projectId, text) {
    try {
        const res = await fetch(BASE+'/api/projects/pk-comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId, comment: text })
        });
        if (res.ok) {
            pkComments[projectId] = text;
            return true;
        }
    } catch (e) {
        console.error('Ошибка сохранения комментария:', e);
    }
    return false;
}

