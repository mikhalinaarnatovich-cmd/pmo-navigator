.resource-team-filter select {
    padding: 6px 10px;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    font-size: 12px;
    max-width: 220px;
}
.resource-hours-hint {
    font-size: 10px;
    color: #9CA3AF;
    margin-top: 2px;
}
.resource-lock-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(245, 158, 11, .15);
    color: #D97706;
    border: 1px solid rgba(245, 158, 11, .35);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}
.resource-lock-btn:hover { background: rgba(245, 158, 11, .30); }
.resource-history-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(99, 102, 241, .15);
    color: #6366F1;
    border: 1px solid rgba(99, 102, 241, .35);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}
.resource-history-btn:hover { background: rgba(99, 102, 241, .30); }
.resource-history-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.4);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
}
.resource-history-modal.open { display: flex; }
.resource-history-box {
    background: #FFFFFF;
    border-radius: 12px;
    width: 800px;
    max-height: 80vh;
    overflow: auto;
    padding: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.3);
}
.resource-history-close {
    float: right;
    font-size: 22px;
    cursor: pointer;
    color: #9CA3AF;
    border: none;
    background: none;
}
.resource-history-table {
    width: 100%;
    font-size: 13px;
    border-collapse: collapse;
    margin-top: 12px;
}
.resource-history-table th {
    text-align: left;
    padding: 8px 10px;
    background: #F9FAFB;
    border-bottom: 2px solid #E5E7EB;
    font-size: 11px;
    text-transform: uppercase;
    color: #6B7280;
}
.resource-history-table td {
    padding: 8px 10px;
    border-bottom: 1px solid #F3F4F6;
}
.resource-lock-panel {
    padding: 12px 20px;
    background: #FFFBEB;
    border-bottom: 1px solid #FDE68A;
    display: none;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}
.resource-lock-panel.open { display: flex; }
.resource-lock-panel select {
    padding: 6px 10px;
    border: 1px solid #FDE68A;
    border-radius: 6px;
    font-size: 12px;
}
.resource-preview-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: #2563EB;
    cursor: pointer;
    margin-right: 8px;
}
.resource-preview-btn:hover { text-decoration: underline; }
.file-preview-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.7);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
}
.file-preview-modal.open { display: flex; }
.file-preview-box {
    background: #FFFFFF;
    border-radius: 12px;
    width: 90vw;
    height: 85vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.file-preview-header {
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #E5E7EB;
}
.file-preview-iframe {
    flex: 1;
    border: none;
    width: 100%;
}

.resource-empty {
    color: #9CA3AF;
    text-align: center;
    padding: 42px 20px;
    font-size: 13px;
}
.resource-control-wrap {
    flex: 1;
    overflow: auto;
    padding-bottom: 20px;
}

.resource-control-table {
    max-width: none;
}

.resource-control-table th,
.resource-control-table td {
    padding: 11px 16px;
}

.resource-summary {
    padding-bottom: 10px;
}
.resource-export-btn,
.resource-analytics-btn,
.resource-filter-btn {
    border: 1px solid #BFDBFE;
    border-radius: 7px;
    padding: 8px 12px;
    background: #EFF6FF;
    color: #1D4ED8;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s, border-color .15s;
}

.resource-export-btn:hover,
.resource-analytics-btn:hover,
.resource-filter-btn:hover {
    background: #DBEAFE;
    border-color: #93C5FD;
}

.resource-filter-btn.active {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
}

.resource-analytics {
    display: none;
    margin: 0 20px 20px;
    padding: 18px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

.resource-analytics.open {
    display: block;
}

.resource-analytics-head {
    display: flex;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid #E5E7EB;
}

.resource-analytics-title {
    width: 100%;
    font-size: 15px;
    font-weight: 700;
    color: #111827;
}

.resource-analytics-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.resource-analytics-field label {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
}

.resource-analytics-field input {
    min-width: 155px;
    padding: 7px 10px;
    border: 1px solid #D1D5DB;
    border-radius: 7px;
    font: inherit;
    font-size: 13px;
    outline: none;
}

.resource-analytics-field input:focus {
    border-color: #2563EB;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
}

.resource-analytics-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(170px, 1fr));
    gap: 12px;
    margin-bottom: 18px;
}

.resource-analytics-card {
    padding: 13px 15px;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

.resource-analytics-card-label {
    margin-bottom: 5px;
    color: #6B7280;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .35px;
}

.resource-analytics-card-value {
    color: #2563EB;
    font-size: 24px;
    font-weight: 700;
}

.resource-analytics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(300px, 1fr));
    gap: 18px;
}

.resource-analytics-section {
    min-width: 0;
}

.resource-analytics-section-title {
    margin-bottom: 9px;
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

.resource-analytics-table-wrap {
    max-height: 320px;
    overflow: auto;
    border: 1px solid #E5E7EB;
    border-radius: 9px;
}

.resource-analytics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}

.resource-analytics-table th {
    position: sticky;
    top: 0;
    padding: 9px 10px;
    background: #F9FAFB;
    color: #6B7280;
    border-bottom: 1px solid #E5E7EB;
    text-align: left;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .35px;
}

.resource-analytics-table td {
    padding: 9px 10px;
    border-bottom: 1px solid #F3F4F6;
    color: #374151;
}

.resource-analytics-table tr:last-child td {
    border-bottom: none;
}

.resource-analytics-table td:last-child,
.resource-analytics-table th:last-child {
    text-align: right;
    white-space: nowrap;
}

.resource-analytics-empty {
    padding: 22px 12px;
    color: #9CA3AF;
    text-align: center;
    font-size: 12px;
}

@@media (max-width: 950px) {
    .resource-analytics-cards {
        grid-template-columns: repeat(2, minmax(150px, 1fr));
    }

    .resource-analytics-grid {
        grid-template-columns: 1fr;
    }
}
.resource-actions-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 10px 20px;
    background: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    flex-shrink: 0;
}

.resource-actions-separator {
    width: 1px;
    height: 24px;
    margin: 0 3px;
    background: #E5E7EB;
}

.resource-export-btn,
.resource-analytics-btn,
.resource-filter-btn {
    border: 1px solid #BFDBFE;
    border-radius: 7px;
    padding: 7px 11px;
    background: #EFF6FF;
    color: #1D4ED8;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    transition: background .15s, border-color .15s;
}

.resource-export-btn:hover,
.resource-analytics-btn:hover,
.resource-filter-btn:hover {
    background: #DBEAFE;
    border-color: #93C5FD;
}

.resource-filter-btn.active {
    background: #2563EB;
    border-color: #2563EB;
    color: #FFFFFF;
}

.resource-analytics {
    display: none;
    flex: none;
    overflow: visible;
    margin: 14px 20px;
    padding: 16px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 10px;
}

.resource-analytics.open {
    display: block;
}

.resource-analytics-head {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    flex-wrap: wrap;
    padding-bottom: 13px;
    margin-bottom: 13px;
    border-bottom: 1px solid #E5E7EB;
}

.resource-analytics-title {
    flex-basis: 100%;
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

.resource-analytics-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.resource-analytics-field label {
    color: #6B7280;
    font-size: 11px;
    font-weight: 600;
}

.resource-analytics-field input {
    width: 155px;
    padding: 7px 9px;
    border: 1px solid #D1D5DB;
    border-radius: 7px;
    background: #FFFFFF;
    font: inherit;
    font-size: 13px;
    outline: none;
}

.resource-analytics-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    gap: 10px;
    margin-bottom: 16px;
}

.resource-analytics-card {
    min-width: 0;
    padding: 12px 14px;
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 9px;
}

.resource-analytics-card-label {
    overflow: hidden;
    color: #6B7280;
    font-size: 10px;
    font-weight: 600;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
}

.resource-analytics-card-value {
    margin-top: 5px;
    color: #2563EB;
    font-size: 22px;
    font-weight: 700;
}

.resource-analytics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 14px;
}

.resource-analytics-section {
    min-width: 0;
}

.resource-analytics-section:last-child {
    grid-column: 1 / -1;
}

.resource-analytics-section-title {
    margin-bottom: 8px;
    color: #374151;
    font-size: 12px;
    font-weight: 700;
}

.resource-analytics-table-wrap {
    max-height: 260px;
    overflow: auto;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

.resource-analytics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
}

.resource-analytics-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 8px 9px;
    background: #F9FAFB;
    border-bottom: 1px solid #E5E7EB;
    color: #6B7280;
    text-align: left;
    font-size: 10px;
    text-transform: uppercase;
}

.resource-analytics-table td {
    padding: 8px 9px;
    border-bottom: 1px solid #F3F4F6;
    color: #374151;
}

.resource-analytics-table td:last-child,
.resource-analytics-table th:last-child {
    text-align: right;
    white-space: nowrap;
}

.resource-analytics-empty {
    padding: 22px !important;
    color: #9CA3AF !important;
    text-align: center !important;
}

@@media (max-width: 1050px) {
    .resource-analytics-cards {
        grid-template-columns: repeat(2, minmax(150px, 1fr));
    }

    .resource-analytics-grid {
        grid-template-columns: 1fr;
    }

    .resource-analytics-section:last-child {
        grid-column: auto;
    }
}

@@media (max-width: 640px) {
    .resource-actions-bar {
        align-items: stretch;
    }

    .resource-actions-bar button {
        flex: 1 1 auto;
    }

    .resource-actions-separator {
        display: none;
    }

    .resource-analytics-cards {
        grid-template-columns: 1fr;
    }
}
.resource-view.active {
    overflow-y: auto;
}

.resource-control-wrap {
    flex: none;
    min-height: 280px;
    overflow: visible;
    padding-bottom: 24px;
}

.resource-analytics {
    flex-shrink: 0;
}
</style>
</head>
<body>
<div class="app">

<!-- ════ LOADING OVERLAY ════════════════════════════════════════════════════ -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="spinner"></div>
  <div class="loading-text">Загрузка данных...</div>
  <div class="progress-bar-wrap"><div class="progress-bar" id="progressBar"></div></div>
</div>

<!-- ════ HEADER ═════════════════════════════════════════════════════════════ -->
<header class="header">
  <div class="header-logo">
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
      <rect width="28" height="28" rx="7" fill="#2563EB" fill-opacity=".25"/>
      <path d="M7 8h14M7 14h10M7 20h12" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/>
      <circle cx="21" cy="20" r="4" fill="#34D399"/>
    </svg>
    <div>
      <div class="header-title">PMO Навигатор</div>
      <div class="header-sub">Портфель проектов</div>
    </div>
  </div>
  <div class="header-spacer"></div>
  <div class="header-user">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
    </svg>
    <span id="userDisplay">@display</span>
  </div>
<button class="header-resource"
        id="btnResource"
        type="button"
        onclick="resourceOpen()">
    Ресурсный план
</button>
  <!-- Портфель -->
  <button class="header-portfolio" id="btnPortfolio">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <rect x="3" y="4" width="18" height="16" rx="2"/>
      <line x1="3" y1="9" x2="21" y2="9"/>
      <line x1="8" y1="4" x2="8" y2="9"/>
      <line x1="16" y1="4" x2="16" y2="9"/>
    </svg>
    Портфель
  </button>
  <!-- Запросы на изменение -->
  <button class="header-cr" id="btnCR">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="9" y1="13" x2="15" y2="13"/>
      <line x1="9" y1="17" x2="13" y2="17"/>
    </svg>
    Запросы на изменение
  </button>
  <!-- ПК -->
  <button class="header-pk" id="btnPK">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    ПК
  <!-- Дашборд -->
  <button class="header-dashboard" id="btnDashboard">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <rect x="3" y="3" width="7" height="9" rx="1"/>
      <rect x="14" y="3" width="7" height="5" rx="1"/>
      <rect x="14" y="12" width="7" height="9" rx="1"/>
      <rect x="3" y="16" width="7" height="5" rx="1"/>
    </svg>
    Дашборд
  </button>
  </button>
  <!-- Справка -->
  <button class="header-reload" onclick="document.getElementById('helpModal').classList.remove('hidden')">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <circle cx="12" cy="12" r="10"/>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
    Справка
  </button>
  <!-- Обновить -->
  <button class="header-reload" id="btnReload" onclick="reloadData()">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M1 4v6h6"/><path d="M23 20v-6h-6"/>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/>
    </svg>
    Обновить
  </button>
</header>

<!-- ════ BODY ════════════════════════════════════════════════════════════════ -->
<div class="body">

  <!-- Sidebar -->
  <nav class="sidebar" id="sidebarNav">
    <div class="sidebar-title">Статус</div>
    <div class="status-list" id="statusList"></div>
  </nav>

  <!-- ════ ОСНОВНОЙ ВИД ════════════════════════════════════════════════════ -->
  <div class="main" id="mainView">
    <div class="toolbar">
      <div class="search-wrap">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="searchInput" placeholder="Поиск по названию, ID, заказчику, РП..."/>
      </div>
      <select class="tb-filter" id="tbDept" onchange="applyToolbarFilters()"><option value="">Отдел</option></select>
      <select class="tb-filter" id="tbPriority" onchange="applyToolbarFilters()"><option value="">Приоритет</option></select>
      <select class="tb-filter" id="tbPM" onchange="applyToolbarFilters()"><option value="">Рук. проекта</option></select>
      <select class="tb-filter" id="tbCustomer" onchange="applyToolbarFilters()"><option value="">Заказчик</option></select>
      <select class="tb-filter" id="tbCurator" onchange="applyToolbarFilters()"><option value="">Куратор</option></select>
      <div class="toolbar-info" id="toolbarInfo">—</div>
    </div>
    <div class="table-wrap">
      <table class="projects-table">
        <thead>
          <tr>
            <th class="col-id" data-sort="projectId" style="cursor:pointer" title="Сортировать">ID ↕</th>
            <th class="col-name" data-sort="name" style="cursor:pointer" title="Сортировать">Проект ↕</th>
            <th class="col-cust" data-sort="customer" style="cursor:pointer" title="Сортировать">Заказчик / Куратор ↕</th>
            <th class="col-pm" data-sort="projectManager" style="cursor:pointer" title="Сортировать">Рук. проекта ↕</th>
            <th data-sort="planEnd" style="cursor:pointer" title="Сортировать">План. дата ↕</th>
            <th data-sort="status" style="cursor:pointer" title="Сортировать">Статус ↕</th>
            <th class="col-prio" data-sort="priority" style="cursor:pointer" title="Сортировать">Приоритет ↕</th>
          </tr>
        </thead>
        <tbody id="projectsTbody"></tbody>
      </table>
    </div>
  </div>
  <div class="resource-view" id="resourceView">

<div class="resource-toolbar">
    <div class="resource-field">
        <label for="resourcePeriod">Месяц</label>
        <input id="resourcePeriod" type="month">
    </div>

    <div class="resource-field">
        <label>Вид деятельности</label>
        <div class="resource-kind-group" id="resourceKindGroup">
            <button class="resource-kind-btn active" data-kind="Project" type="button"
                    onclick="resourceSetKind('Project')">Проект</button>
            <button class="resource-kind-btn" data-kind="Operational" type="button"
                    onclick="resourceSetKind('Operational')">Операционная</button>
            <button class="resource-kind-btn" data-kind="Vacation" type="button"
                    onclick="resourceSetKind('Vacation')">Отпуск</button>
        </div>
    </div>

    <div class="resource-field">
        <label for="resourceEmployee">Сотрудник</label>
        <select id="resourceEmployee">
            <option value="">Выберите сотрудника</option>
        </select>
    </div>

    <!-- Проект (только для Kind=Project) -->
    <div class="resource-field" id="resourceProjectField">
        <label for="resourceProject">Проект</label>
        <select id="resourceProject">
            <option value="">Выберите проект</option>
        </select>
    </div>

    <!-- Активность (для Operational/Vacation) -->
    <div class="resource-field" id="resourceActivityField" style="display:none">
        <label for="resourceActivity">Активность</label>
        <select id="resourceActivity">
            <option value="">Выберите</option>
        </select>
    </div>

    <div class="resource-field">
        <label for="resourceHours">Часы</label>
        <input id="resourceHours" type="number" min="0" step="0.5"
               placeholder="160" style="width:80px">
        <div class="resource-hours-hint" id="resourceHoursHint">или введите % ниже</div>
    </div>

    <div class="resource-field">
        <label for="resourcePercent">Загрузка, %</label>
