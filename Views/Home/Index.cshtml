async function resourceOpenHistory(employeeName) {
    document.getElementById('resourceHistoryName').textContent = employeeName;
    document.getElementById('resourceHistoryModal').classList.add('open');

    const tbody = document.getElementById('resourceHistoryTbody');
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#9CA3AF;padding:20px">Загрузка...</td></tr>';

    try {
        const res = await fetch(resourceApiUrl(`/history?employee=${encodeURIComponent(employeeName)}`));
        if (!res.ok) throw new Error('Не удалось загрузить историю.');
        const rows = await res.json();

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#9CA3AF;padding:20px">Нет данных</td></tr>';
