}

function resourceSelectEmployee(employeeName) {
    const periodInput = document.getElementById('resourcePeriod');
    const panel = document.getElementById('resourcePersonPanel');
    const data = window.resourcePlanData ?? { items: [] };

    const selectedItems = (data.items ?? [])
        .filter(item =>
            String(item.employeeName).toLowerCase() ===
            String(employeeName).toLowerCase());

    const total = selectedItems.reduce(
        (sum, item) => sum + Number(item.allocationPercent || 0),
        0);

    const periodText = periodInput?.value
        ? new Date(`${periodInput.value}-01T00:00:00`).toLocaleDateString(
            'ru-RU', { month: 'long', year: 'numeric' })
        : '';

    document.getElementById('resourcePersonName').textContent = employeeName;
    document.getElementById('resourcePersonPeriod').textContent = periodText;
    document.getElementById('resourcePersonTotal').textContent =
        `${total.toLocaleString('ru-RU')}%`;

    const itemsHost = document.getElementById('resourcePersonItems');

    if (!selectedItems.length) {
        itemsHost.innerHTML =
            '<div class="resource-person-empty">' +
            'За выбранный месяц назначений пока нет.' +
            '</div>';
    } else {
        itemsHost.innerHTML = selectedItems.map(item => `
        <div class="resource-person-item">
            <div class="resource-person-item-main">
                <div class="resource-person-project">
                    ${resourceProjectOrActivity(item)}
                    <span style="font-size:10px;color:#9CA3AF">${resourceKindLabel(item.kind)}</span>
                </div>
                <div class="resource-person-comment">
                    ${resourceEscape(item.comment || 'Без комментария')}
                    ${item.plannedHours ? ' · ' + Number(item.plannedHours).toLocaleString('ru-RU') + ' ч.' : ''}
                </div>
            </div>
            <div class="resource-person-percent">
                ${Number(item.allocationPercent).toLocaleString('ru-RU')}%
            </div>
            <div class="resource-person-actions">
                <button class="resource-person-edit" type="button"
                        onclick="resourceEditAllocation(${item.id})">Изменить</button>
                <button class="resource-person-delete" type="button"
                        onclick="resourceDeleteFromPanel(${item.id})">Удалить</button>
            </div>
        </div>
    `).join('');
    }
    panel.dataset.employeeName = employeeName;
    panel.classList.add('open');
}

