@{
    Layout = null;
    var login   = ViewBag.Login   as string ?? "";
    var display = ViewBag.Display as string ?? "";
}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>PMO Навигатор</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══ RESET & BASE ══════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:'Inter',system-ui,sans-serif;font-size:14px;
  background:#F4F5F7;color:#1E2128}
button{font-family:inherit;cursor:pointer}
input,select{font-family:inherit}

/* ═══ LAYOUT ════════════════════════════════════════════════════════════════ */
.app{display:flex;flex-direction:column;height:100vh;overflow:hidden}

/* Header */
.header{background:#1A2233;color:#fff;padding:0 24px;height:56px;
  display:flex;align-items:center;gap:16px;flex-shrink:0;z-index:100;
  box-shadow:0 2px 8px rgba(0,0,0,.25)}
.header-logo{display:flex;align-items:center;gap:10px}
.header-logo svg{opacity:.9}
.header-title{font-size:16px;font-weight:700;letter-spacing:-.2px}
.header-sub{font-size:11px;opacity:.55;font-weight:400}
.header-spacer{flex:1}
.header-user{display:flex;align-items:center;gap:8px;font-size:12px;opacity:.8}
.header-user svg{opacity:.7}
.header-reload{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);
  color:#fff;font-size:12px;padding:5px 12px;border-radius:6px;
  display:flex;align-items:center;gap:6px;transition:background .15s}
.header-reload:hover{background:rgba(255,255,255,.2)}
.header-reload.loading svg{animation:spin 1s linear infinite}
/* Кнопка Портфель в header */
.header-portfolio{background:rgba(99,102,241,.25);border:1px solid rgba(99,102,241,.4);
  color:#C7D2FE;font-size:12px;padding:5px 14px;border-radius:6px;
  display:flex;align-items:center;gap:6px;transition:background .15s,border-color .15s}
.header-portfolio:hover{background:rgba(99,102,241,.4)}
.header-portfolio.active{background:#4F46E5;border-color:#4F46E5;color:#fff}
/* Кнопка ПК в header */
.header-pk{background:rgba(5,150,105,.2);border:1px solid rgba(5,150,105,.35);
  color:#6EE7B7;font-size:12px;padding:5px 14px;border-radius:6px;
  display:flex;align-items:center;gap:6px;transition:background .15s,border-color .15s}
.header-pk:hover{background:rgba(5,150,105,.35)}
.header-pk.active{background:#059669;border-color:#059669;color:#fff}
/* Кнопка Дашборд в header */
.header-dashboard{background:rgba(245,158,11,.18);border:1px solid rgba(245,158,11,.32);
  color:#FCD34D;font-size:12px;padding:5px 14px;border-radius:6px;
  display:flex;align-items:center;gap:6px;transition:background .15s,border-color .15s}
.header-dashboard:hover{background:rgba(245,158,11,.32)}
.header-dashboard.active{background:#F59E0B;border-color:#F59E0B;color:#fff}
/* Дашборд view */
.dashboard-view{flex:1;display:none;flex-direction:column;overflow-y:auto;background:#F4F5F7}
.dashboard-view.active{display:flex}
.dash-counters{display:flex;gap:12px;padding:10px 20px;background:#fff;border-bottom:1px solid #E5E7EB;flex-shrink:0;flex-wrap:wrap}
.dash-counter-card{flex:1;min-width:100px;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:10px;padding:10px 16px;display:flex;flex-direction:column;gap:2px;cursor:default}
.dash-counter-card.clickable{cursor:pointer;transition:border-color .15s,background .15s}
.dash-counter-card.clickable:hover{border-color:#2563EB;background:#EFF6FF}
.dash-counter-label{font-size:11px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:.4px}
.dash-counter-value{font-size:28px;font-weight:700;line-height:1.1}
.dash-counter-all .dash-counter-value{color:#2563EB}
.dash-counter-work .dash-counter-value{color:#16A34A}
.dash-counter-red .dash-counter-value{color:#DC2626}
.dash-counter-yellow .dash-counter-value{color:#D97706}
.dash-counter-pause .dash-counter-value{color:#9CA3AF}
.dash-counter-deadline .dash-counter-value{color:#7C3AED}
.dash-counter-done .dash-counter-value{color:#6B7280}
.dash-charts-row{display:flex;gap:12px;padding:12px 20px;background:#fff;flex-wrap:wrap}
/* Панели вкладок дашборда: видимость через класс .active, а не инлайн-display */
.pk-chart-pane[data-dpane]{display:none;padding:20px;width:100%}
.pk-chart-pane[data-dpane].active{display:block}
.pk-chart-pane[data-dpane="health"].active{display:flex;gap:24px;flex-wrap:wrap}
@@keyframes spin{to{transform:rotate(360deg)}}

/* Body */
.body{display:flex;flex:1;overflow:hidden}

/* Sidebar */
.sidebar{width:220px;flex-shrink:0;background:#fff;border-right:1px solid #E5E7EB;
  display:flex;flex-direction:column;overflow:hidden}
.sidebar-title{padding:14px 16px 10px;font-size:11px;font-weight:600;
  color:#9CA3AF;text-transform:uppercase;letter-spacing:.8px}
.status-list{flex:1;overflow-y:auto;padding:0 8px 12px}
.status-btn{width:100%;text-align:left;border:none;background:none;
  padding:8px 10px;border-radius:8px;font-size:13px;color:#374151;
  display:flex;align-items:center;justify-content:space-between;
  transition:background .12s,color .12s;cursor:pointer}
.status-btn:hover{background:#F3F4F6}
.status-btn.active{background:#EFF6FF;color:#1D4ED8;font-weight:600}
.status-btn .cnt{font-size:11px;background:#E5E7EB;color:#6B7280;
  padding:1px 7px;border-radius:10px;font-weight:500}
.status-btn.active .cnt{background:#DBEAFE;color:#1D4ED8}
.sidebar-sep{height:1px;background:#E5E7EB;margin:8px 16px}

/* Main panel */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden}

/* Toolbar */
.toolbar{padding:14px 20px 12px;background:#fff;border-bottom:1px solid #E5E7EB;
  display:flex;align-items:center;gap:10px;flex-shrink:0}
.search-wrap{flex:1;max-width:360px;position:relative}
.search-wrap input{width:100%;border:1px solid #D1D5DB;border-radius:8px;
  padding:7px 12px 7px 34px;font-size:13px;outline:none;
  transition:border-color .15s,box-shadow .15s;background:#F9FAFB}
.search-wrap input:focus{border-color:#3B82F6;box-shadow:0 0 0 3px rgba(59,130,246,.12);background:#fff}
.search-icon{position:absolute;left:10px;top:50%;transform:translateY(-50%);
  color:#9CA3AF;pointer-events:none}
.toolbar-info{font-size:12px;color:#9CA3AF;margin-left:auto}
.tb-filter{border:1px solid #D1D5DB;border-radius:7px;padding:5px 8px;
  font-size:12px;color:#374151;background:#F9FAFB;outline:none;cursor:pointer;
  max-width:130px;transition:border-color .15s}
.tb-filter:focus{border-color:#3B82F6}

/* Table */
.table-wrap{flex:1;overflow:auto;padding:16px 20px}
.projects-table{width:100%;border-collapse:collapse;font-size:13px}
.projects-table th{position:sticky;top:0;background:#F9FAFB;
  border-bottom:2px solid #E5E7EB;padding:9px 12px;text-align:left;
  font-size:11px;font-weight:600;color:#6B7280;text-transform:uppercase;
  letter-spacing:.5px;white-space:nowrap;z-index:10}
.projects-table td{padding:10px 12px;border-bottom:1px solid #F3F4F6;
  vertical-align:middle}
.projects-table tr:hover td{background:#F8FAFF;cursor:pointer}
.projects-table tr.selected td{background:#EFF6FF}

.col-id{width:60px;color:#6B7280}
.col-name{max-width:300px}
.p-name{font-weight:600;color:#111827;line-height:1.35}
.p-dept{font-size:11px;color:#9CA3AF;margin-top:2px}
.col-pm{white-space:nowrap}
.col-cust{white-space:nowrap}
.col-dates{white-space:nowrap;color:#374151;font-size:12px}
.col-prio{width:100px}

/* Бейджи статусов */
.badge{display:inline-flex;align-items:center;gap:4px;
  font-size:11px;font-weight:600;padding:3px 9px;border-radius:12px;white-space:nowrap}
.badge::before{content:'';width:6px;height:6px;border-radius:50%;flex-shrink:0}
.s-active{background:#DCFCE7;color:#166534}.s-active::before{background:#16A34A}
.s-pause{background:#EDE9FE;color:#5B21B6}.s-pause::before{background:#8B5CF6}
.s-done{background:#F3F4F6;color:#6B7280}.s-done::before{background:#9CA3AF}
.s-init{background:#EDE9FE;color:#5B21B6}.s-init::before{background:#7C3AED}
.s-plan{background:#DBEAFE;color:#1E40AF}.s-plan::before{background:#2563EB}
.s-cancel{background:#FEE2E2;color:#991B1B}.s-cancel::before{background:#DC2626}
.s-backlog{background:#FDF4FF;color:#701A75}.s-backlog::before{background:#A855F7}
.s-finish{background:#E0F2FE;color:#075985}.s-finish::before{background:#0284C7}
.s-delay{background:#FFF7ED;color:#9A3412}.s-delay::before{background:#EA580C}

.prio-0{color:#DC2626;font-weight:700;font-size:11px}
.prio-1{color:#D97706;font-weight:600;font-size:11px}
.prio-2{color:#2563EB;font-size:11px}
.prio-3{color:#6B7280;font-size:11px}
.prio-4{color:#D1D5DB;font-size:11px}

/* ═══ КАРТОЧКА ПРОЕКТА ════════════════════════════════════════════════════ */
.detail-panel{position:fixed;right:0;top:56px;bottom:0;width:480px;z-index:300;
  background:#fff;border-left:1px solid #E5E7EB;
  display:flex;flex-direction:column;overflow:hidden;
  transform:translateX(100%);transition:transform .25s ease;
  box-shadow:-4px 0 24px rgba(0,0,0,.10)}
.detail-panel.open{transform:translateX(0)}

.detail-header{padding:18px 20px 14px;border-bottom:1px solid #F3F4F6;
  display:flex;align-items:flex-start;gap:12px}
.detail-header-info{flex:1;min-width:0}
.detail-id{font-size:11px;color:#9CA3AF;font-weight:600;margin-bottom:3px}
.detail-name{font-size:16px;font-weight:700;color:#111827;line-height:1.3}
.detail-close{border:none;background:none;color:#9CA3AF;
  width:28px;height:28px;border-radius:6px;display:flex;align-items:center;
  justify-content:center;flex-shrink:0;transition:background .12s,color .12s}
.detail-close:hover{background:#F3F4F6;color:#374151}

.detail-body{flex:1;overflow-y:auto;padding:16px 20px}
.detail-section{margin-bottom:20px}
.detail-section-title{font-size:11px;font-weight:600;color:#9CA3AF;
  text-transform:uppercase;letter-spacing:.6px;margin-bottom:10px}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.detail-field label{font-size:11px;color:#9CA3AF;display:block;margin-bottom:3px}
.detail-field span{font-size:13px;color:#111827;font-weight:500;display:block}
.detail-goal{font-size:13px;color:#374151;line-height:1.55;
  background:#F9FAFB;padding:10px 12px;border-radius:8px;border:1px solid #E5E7EB}

.detail-tabs{display:flex;border-bottom:2px solid #E5E7EB;margin-bottom:16px}
.dtab{border:none;background:none;font-size:13px;font-weight:500;
  color:#6B7280;padding:8px 12px;border-bottom:2px solid transparent;
  margin-bottom:-2px;transition:color .12s}
.dtab.active{color:#1D4ED8;border-bottom-color:#1D4ED8;font-weight:600}
.dtab:hover:not(.active){color:#374151}
.dtab-content{display:none}
.dtab-content.active{display:block}

/* Участники */
.member-row{display:flex;align-items:center;gap:10px;
  padding:7px 0;border-bottom:1px solid #F3F4F6}
.member-row:last-child{border-bottom:none}
.member-avatar{width:30px;height:30px;border-radius:50%;background:#E0E7FF;
  color:#3730A3;font-size:11px;font-weight:700;display:flex;align-items:center;
  justify-content:center;flex-shrink:0}
.member-info{flex:1;min-width:0}
.member-name{font-size:13px;font-weight:500;color:#111827}
.member-role{font-size:11px;color:#9CA3AF}

/* Документы */
.doc-row{display:flex;align-items:center;gap:10px;
  padding:7px 0;border-bottom:1px solid #F3F4F6;cursor:pointer}
.doc-row:last-child{border-bottom:none}
.doc-row:hover .doc-name{color:#1D4ED8}
.doc-icon{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;
  justify-content:center;flex-shrink:0;font-size:10px;font-weight:700}
.doc-icon.docx{background:#DBEAFE;color:#1D4ED8}
.doc-icon.xlsx{background:#DCFCE7;color:#166534}
.doc-icon.pptx{background:#FEF3C7;color:#92400E}
.doc-icon.pdf{background:#FEE2E2;color:#991B1B}
.doc-icon.other{background:#F3F4F6;color:#6B7280}
.doc-name{font-size:12px;color:#374151;flex:1;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.doc-date{font-size:11px;color:#9CA3AF;white-space:nowrap}
.doc-empty{font-size:12px;color:#9CA3AF;text-align:center;padding:20px;
  background:#F9FAFB;border-radius:8px}
.doc-folder-group{margin-bottom:8px;border:1px solid #E5E7EB;border-radius:10px;overflow:hidden}
.doc-folder-header{display:flex;align-items:center;gap:8px;padding:8px 12px;
  background:#FFFBEB;cursor:pointer;user-select:none}
.doc-folder-icon{font-size:16px;flex-shrink:0}
.doc-folder-title{font-size:13px;font-weight:600;color:#374151;flex:1}
.doc-folder-cnt{font-size:11px;background:#E5E7EB;color:#6B7280;
  padding:1px 8px;border-radius:10px;font-weight:600}
.doc-folder-cnt.has-files{background:#DBEAFE;color:#1D4ED8}
.doc-folder-cnt.no-files{background:#FEE2E2;color:#DC2626}
.doc-folder-body{padding:4px 8px 8px}

.sd-link{display:inline-flex;align-items:center;gap:6px;
  font-size:13px;color:#2563EB;text-decoration:none;
  padding:7px 12px;border:1px solid #DBEAFE;border-radius:8px;
  background:#EFF6FF;transition:background .12s}
.sd-link:hover{background:#DBEAFE}

/* ═══ ДИАГРАММА ГАНТА (карточка) ═══════════════════════════════════════════ */
.gantt-wrap{overflow-x:auto;padding-bottom:8px}
.gantt-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;min-width:0}
.gantt-label{width:130px;flex-shrink:0;font-size:11px;color:#374151;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}
.gantt-track{flex:1;height:20px;background:#F3F4F6;border-radius:4px;
  position:relative;min-width:160px}
.gantt-bar{position:absolute;height:100%;border-radius:4px;
  display:flex;align-items:center;padding:0 6px;
  font-size:10px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden}
.gantt-bar.active{background:#2563EB}
.gantt-bar.done{background:#9CA3AF}
.gantt-bar.pause{background:#8B5CF6}
.gantt-bar.overdue{background:#DC2626}
.gantt-bar.fact{background:#059669}
.gantt-axis{display:flex;margin-left:138px;margin-bottom:4px;font-size:10px;color:#9CA3AF}
.gantt-axis span{flex:1;text-align:center}
.gantt-today{position:absolute;top:0;bottom:0;width:2px;background:#DC2626;
  opacity:.7;z-index:2;border-radius:1px}
.gantt-empty{font-size:12px;color:#9CA3AF;text-align:center;padding:20px;
  background:#F9FAFB;border-radius:8px}
.gantt-legend{display:flex;gap:12px;margin-top:12px;flex-wrap:wrap}
.gantt-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#6B7280}
.gantt-legend-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}

/* ═══ ПОРТФЕЛЬ — экран ══════════════════════════════════════════════════════ */
.portfolio-view{flex:1;display:none;flex-direction:column;overflow-y:auto;background:#F4F5F7}
.portfolio-view.active{display:flex}

/* Панель фильтров портфеля */
.pf-filters{padding:12px 20px;background:#fff;border-bottom:1px solid #E5E7EB;
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex-shrink:0}
.pf-filters label{font-size:11px;color:#6B7280;font-weight:600;white-space:nowrap}
.pf-select{border:1px solid #D1D5DB;border-radius:7px;padding:5px 10px;
  font-size:12px;color:#374151;background:#F9FAFB;outline:none;cursor:pointer;
  transition:border-color .15s}
.pf-select:focus{border-color:#6366F1;box-shadow:0 0 0 3px rgba(99,102,241,.12)}
.pf-checkbox-wrap{display:flex;align-items:center;gap:5px;font-size:12px;color:#374151;cursor:pointer}
.pf-checkbox-wrap input{cursor:pointer;accent-color:#6366F1}
.pf-sep{width:1px;height:20px;background:#E5E7EB;flex-shrink:0}
.pf-scale-group{display:flex;gap:4px;align-items:center}
.pf-scale-btn{border:1px solid #D1D5DB;background:#F9FAFB;color:#374151;
  font-size:12px;padding:5px 12px;border-radius:7px;transition:all .12s}
.pf-scale-btn:hover{background:#EEF2FF;border-color:#818CF8;color:#4F46E5}
.pf-scale-btn.active{background:#4F46E5;border-color:#4F46E5;color:#fff;font-weight:600}
.pf-reset{border:1px solid #E5E7EB;background:#fff;color:#6B7280;
  font-size:12px;padding:5px 12px;border-radius:7px;margin-left:auto;
  transition:all .12s}
.pf-reset:hover{background:#F3F4F6;color:#374151}
.pf-count{font-size:12px;color:#9CA3AF;white-space:nowrap}

/* Ганта портфеля */
.portfolio-gantt-wrap{flex:1;overflow:auto;padding:16px 20px}
.pg-container{min-width:900px}

/* Заголовок шкалы */
.pg-header{display:flex;margin-bottom:4px}
.pg-header-spacer{width:220px;flex-shrink:0}
.pg-axis-wrap{flex:1;position:relative;height:22px}
.pg-axis-label{position:absolute;font-size:10px;color:#9CA3AF;
  transform:translateX(-50%);white-space:nowrap;top:4px}
.pg-axis-tick{position:absolute;top:0;bottom:0;width:1px;background:#E5E7EB}

/* Строка проекта */
.pg-row{display:flex;align-items:center;border-radius:6px;
  transition:background .1s;cursor:pointer;margin-bottom:3px}
.pg-row:hover{background:rgba(99,102,241,.06)}
.pg-label-cell{width:220px;flex-shrink:0;padding:4px 10px 4px 0;
  display:flex;align-items:center;gap:8px}
.pg-label-id{font-size:10px;color:#9CA3AF;flex-shrink:0;width:32px}
.pg-label-name{font-size:12px;color:#111827;font-weight:500;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}
.pg-track-cell{flex:1;position:relative;height:26px}
.pg-track{position:absolute;inset:3px 0;background:#F3F4F6;border-radius:4px}
.pg-bar{position:absolute;top:3px;bottom:3px;border-radius:4px;
  min-width:4px;transition:opacity .15s;z-index:1}
.pg-bar:hover{opacity:.85}
.pg-bar.pg-active{background:#4F46E5}
.pg-bar.pg-plan{background:#2563EB}
.pg-bar.pg-pause{background:#8B5CF6}
.pg-bar.pg-done{background:#9CA3AF;opacity:.7;border:1px solid #6B7280}
.pg-bar.pg-init{background:#7C3AED}
.pg-bar.pg-finish{background:#0284C7}
.pg-bar.pg-cancel{background:#DC2626;opacity:.5}
.pg-bar.pg-backlog{background:#A855F7}
.pg-bar.pg-delay{background:#EA580C}
.pg-bar.pg-overdue{background:#DC2626}
.pg-today-line{position:absolute;top:0;bottom:0;width:2px;
  background:#DC2626;opacity:.8;z-index:5;border-radius:1px;pointer-events:none}
.pg-grid-line{position:absolute;top:0;bottom:0;width:1px;
  background:#E5E7EB;z-index:0;pointer-events:none}

/* Легенда портфеля */
.pg-legend{display:flex;gap:14px;flex-wrap:wrap;padding:10px 20px;
  background:#fff;border-top:1px solid #E5E7EB;flex-shrink:0}
.pg-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#6B7280}
.pg-legend-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0}
.pg-empty{text-align:center;padding:60px 20px;color:#9CA3AF;font-size:13px}

/* ═══ ПК — экран ════════════════════════════════════════════════════════════ */
.pk-view{flex:1;display:none;flex-direction:column;overflow-y:auto;background:#F4F5F7}
.pk-view.active{display:flex}

/* Шапка ПК */
.pk-header-bar{padding:12px 20px;background:#fff;border-bottom:1px solid #E5E7EB;
  display:flex;align-items:center;gap:12px;flex-shrink:0;flex-wrap:wrap}
.pk-header-title{font-size:14px;font-weight:700;color:#111827}
.pk-header-sub{font-size:12px;color:#9CA3AF}
.pk-count{font-size:12px;color:#6B7280;margin-left:auto;white-space:nowrap}
.pk-filter{border:1px solid #D1D5DB;border-radius:7px;padding:5px 10px;
  font-size:12px;color:#374151;background:#F9FAFB;outline:none;cursor:pointer;
  transition:border-color .15s}
.pk-filter:focus{border-color:#059669}

/* Таблица ПК */
.pk-table-wrap{flex:1;overflow:auto;padding:16px 20px}
.pk-table{width:100%;border-collapse:collapse;font-size:13px}
.pk-table th{position:sticky;top:0;background:#F0FDF4;
  border-bottom:2px solid #BBF7D0;padding:9px 12px;text-align:left;
  font-size:11px;font-weight:600;color:#166534;text-transform:uppercase;
  letter-spacing:.5px;white-space:nowrap;z-index:10}
.pk-table td{padding:9px 12px;border-bottom:1px solid #F3F4F6;vertical-align:middle}
.pk-table tr:hover td{background:#F0FDF4;cursor:pointer}

/* RAG-статус кружки */
.rag-dot{display:inline-block;width:12px;height:12px;border-radius:50%;flex-shrink:0}
.rag-red{background:#DC2626}
.rag-yellow{background:#D97706}
.rag-green{background:#16A34A}
.rag-cell{display:flex;align-items:center;gap:6px}
.rag-label{font-size:11px;color:#6B7280}

/* Строка с красным статусом — жирная левая граница */
.pk-row-red td:first-child{border-left:3px solid #DC2626}
.pk-row-red td{background:#FFF5F5!important}
.pk-row-yellow td{background:#FFFBEB!important}

/* Inline редактирование комментария */
.pk-comment-cell{min-width:180px;max-width:260px}
.pk-comment-text{font-size:12px;color:#374151;cursor:pointer;
  border-radius:4px;padding:3px 6px;transition:background .12s;
  min-height:24px;display:block;line-height:1.5}
.pk-comment-text:hover{background:#F0FDF4}
.pk-comment-text.empty{color:#9CA3AF;font-style:italic}
.pk-comment-edit{display:none;flex-direction:column;gap:6px}
.pk-comment-edit.active{display:flex}
.pk-comment-edit textarea{border:1px solid #BBF7D0;border-radius:6px;
  padding:6px 8px;font-size:12px;font-family:inherit;resize:vertical;
  min-height:56px;width:100%;outline:none;
  transition:border-color .15s,box-shadow .15s}
.pk-comment-edit textarea:focus{border-color:#059669;box-shadow:0 0 0 3px rgba(5,150,105,.12)}
.pk-comment-save{background:#059669;color:#fff;border:none;
  padding:4px 12px;border-radius:6px;font-size:11px;font-weight:600;
  cursor:pointer;transition:background .12s;align-self:flex-start}
.pk-comment-save:hover{background:#047857}
.pk-comment-cancel{background:none;border:none;color:#9CA3AF;
  font-size:11px;padding:4px 8px;cursor:pointer;transition:color .12s}
.pk-comment-cancel:hover{color:#374151}
.pk-comment-actions{display:flex;gap:4px;align-items:center}

/* Диаграммы ПК */
.pk-charts-row{display:flex;gap:12px;padding:12px 20px;background:#fff;
  border-bottom:1px solid #E5E7EB;flex-shrink:0;flex-wrap:wrap}
.pk-chart-card{flex:1;min-width:220px;background:#F9FAFB;border:1px solid #E5E7EB;
  border-radius:12px;padding:12px 16px;display:flex;flex-direction:column;align-items:center;gap:8px}
.pk-chart-title{font-size:12px;font-weight:700;color:#374151;align-self:flex-start}
.pk-chart-legend{display:flex;flex-direction:column;gap:4px;width:100%}
.pk-legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:#374151}
.pk-legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.pk-legend-label{flex:1}
.pk-legend-cnt{font-weight:700;color:#374151}

/* Скоринг бейдж */
.score-badge{display:inline-block;font-size:12px;font-weight:700;
  padding:2px 8px;border-radius:10px;min-width:36px;text-align:center}
.score-high{background:#DCFCE7;color:#166534}
.score-mid{background:#FEF3C7;color:#92400E}
.score-low{background:#FEE2E2;color:#991B1B}

/* ═══ СЧЁТЧИКИ ПК ══════════════════════════════════════════════════════════ */
.pk-counters{display:flex;gap:12px;padding:10px 20px;background:#fff;border-bottom:1px solid #E5E7EB;flex-shrink:0;flex-wrap:wrap}
.pk-counter-card{flex:1;min-width:100px;background:#F9FAFB;border:1px solid #E5E7EB;border-radius:10px;padding:10px 16px;display:flex;flex-direction:column;gap:2px;cursor:default}
.pk-counter-label{font-size:11px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:.4px}
.pk-counter-value{font-size:28px;font-weight:700;line-height:1.1}
.pk-counter-all .pk-counter-value{color:#2563EB}
.pk-counter-work .pk-counter-value{color:#16A34A}
.pk-counter-red .pk-counter-value{color:#DC2626}
.pk-counter-yellow .pk-counter-value{color:#D97706}
.pk-counter-pause .pk-counter-value{color:#9CA3AF}
.pk-counter-deadline .pk-counter-value{color:#7C3AED}

/* ═══ ЗАПРОСЫ НА ИЗМЕНЕНИЕ ══════════════════════════════════════════════════ */
.cr-view{flex:1;display:none;flex-direction:column;overflow:hidden;background:#F4F5F7}
.cr-view.active{display:flex}
.cr-header-bar{padding:12px 20px;background:#fff;border-bottom:1px solid #E5E7EB;
  display:flex;align-items:center;gap:12px;flex-shrink:0;flex-wrap:wrap}
.cr-header-title{font-size:14px;font-weight:700;color:#111827}
.cr-header-sub{font-size:12px;color:#9CA3AF}
.cr-count{font-size:12px;color:#6B7280;margin-left:auto;white-space:nowrap}
.cr-filter{border:1px solid #D1D5DB;border-radius:7px;padding:5px 10px;
  font-size:12px;color:#374151;background:#F9FAFB;outline:none;cursor:pointer}
.cr-filter:focus{border-color:#2563EB}
.cr-table-wrap{flex:1;overflow:auto;padding:16px 20px}
.cr-table{width:100%;border-collapse:collapse;font-size:13px}
.cr-table th{position:sticky;top:0;background:#EFF6FF;
  border-bottom:2px solid #BFDBFE;padding:9px 12px;text-align:left;
  font-size:11px;font-weight:600;color:#1D4ED8;text-transform:uppercase;
  letter-spacing:.5px;white-space:nowrap;z-index:10}
.cr-table td{padding:9px 12px;border-bottom:1px solid #F3F4F6;vertical-align:middle}
.cr-table tr:hover td{background:#EFF6FF;cursor:pointer}
.cr-open-btn{background:#2563EB;color:#fff;border:none;padding:4px 12px;
  border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;
  transition:background .12s}
.cr-open-btn:hover{background:#1D4ED8}
.header-cr{display:flex;align-items:center;gap:6px;padding:6px 14px;
  background:#059669;color:#fff;border:none;border-radius:8px;
  font-size:12px;font-weight:600;cursor:pointer;transition:background .15s,transform .1s}
.header-cr:hover{background:#047857}
.header-cr.active{background:#047857;box-shadow:0 0 0 2px #6EE7B7}

/* ═══ LOADING OVERLAY ═══════════════════════════════════════════════════════ */
.loading-overlay{position:fixed;inset:0;background:rgba(26,34,51,.65);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  z-index:1000;gap:16px;backdrop-filter:blur(4px)}
.loading-overlay.hidden{display:none}
.spinner{width:44px;height:44px;border:4px solid rgba(255,255,255,.2);
  border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
.loading-text{color:#fff;font-size:14px;font-weight:500;opacity:.9}
.progress-bar-wrap{width:280px;height:4px;background:rgba(255,255,255,.2);border-radius:2px}
.progress-bar{height:100%;background:#60A5FA;border-radius:2px;transition:width .3s;width:0}

/* ═══ СОРТИРОВКА & ПРОСРОЧКА ══════════════════════════════════════════════════ */
.projects-table th[data-sort]:hover{background:#EFF6FF;color:#1D4ED8}
.projects-table th.sort-asc::after{content:' ↑'}
.projects-table th.sort-desc::after{content:' ↓'}
.projects-table th.sort-asc,
.projects-table th.sort-desc{color:#1D4ED8;background:#EFF6FF}
.row-overdue td{background:#FFF5F5!important}
.row-overdue td:first-child{border-left:3px solid #DC2626}

/* ═══ МОДАЛЬНОЕ ОКНО ════════════════════════════════════════════════════════ */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:500;
  display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.modal-backdrop.hidden{display:none}
.modal-box{background:#fff;border-radius:12px;width:560px;max-width:96vw;
  max-height:88vh;display:flex;flex-direction:column;overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,.25)}
.modal-head{padding:20px 24px 16px;border-bottom:1px solid #E5E7EB;
  display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.modal-head-title{font-size:17px;font-weight:700;color:#111827}
.modal-head-close{border:none;background:none;font-size:22px;color:#9CA3AF;
  cursor:pointer;width:30px;height:30px;border-radius:6px;
  display:flex;align-items:center;justify-content:center;line-height:1}
.modal-head-close:hover{background:#F3F4F6;color:#374151}
.modal-body{padding:20px 24px;overflow-y:auto;flex:1}
.modal-foot{padding:14px 24px;border-top:1px solid #E5E7EB;
  text-align:right;flex-shrink:0}
.modal-foot button{background:#2563EB;color:#fff;border:none;
  padding:8px 22px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer}
.modal-foot button:hover{background:#1D4ED8}

.help-section{margin-bottom:18px}
.help-section-title{font-size:13px;font-weight:700;color:#1D4ED8;margin-bottom:7px}
.help-section p,.help-section li{font-size:13px;color:#374151;line-height:1.65}
.help-section ul{padding-left:18px;display:flex;flex-direction:column;gap:4px}
.help-table{width:100%;border-collapse:collapse;font-size:12px;margin-top:6px}
.help-table td{padding:5px 8px;border-bottom:1px solid #F3F4F6;vertical-align:top}
.help-table tr:nth-child(odd) td{background:#F9FAFB}
.help-table td:first-child{font-weight:600;white-space:nowrap;color:#111827;width:160px}
code{background:#F3F4F6;padding:1px 5px;border-radius:3px;font-size:12px;color:#374151}

/* ═══ SCROLLBAR ═════════════════════════════════════════════════════════════ */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#D1D5DB;border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:#9CA3AF}

@@media (max-width:900px){
  .detail-panel{position:fixed;right:0;top:56px;bottom:0;z-index:200;
    box-shadow:-4px 0 20px rgba(0,0,0,.15)}
}
@@media (max-width:640px){
  .sidebar{width:48px}
  .status-btn .label{display:none}
  .sidebar-title{display:none}
}
/* ── Ресурсный план ───────────────────────────────────── */
.resource-view {
    flex: 1;
    display: none;
    flex-direction: column;
    overflow: hidden;
    background: #F4F5F7;
}

.resource-view.active {
    display: flex;
}

.header-resource {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(37, 99, 235, .20);
    color: #BFDBFE;
    border: 1px solid rgba(96, 165, 250, .35);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s, border-color .15s;
}

.header-resource:hover {
    background: rgba(37, 99, 235, .35);
}

.header-resource.active {
    background: #2563EB;
    border-color: #2563EB;
