// ════ ДИАГРАММА ГАНТА (карточка) ═════════════════════════════════════════════
function renderGantt(p) {
    const el = document.getElementById('ganttChart');
    const rows = [];

    const planS = parseRuDate(p.planStart), planE = parseRuDate(p.planEnd);
    const factS = parseRuDate(p.factStart), factE = parseRuDate(p.factEnd);
    if (planS && planE) {
        rows.push({ label: 'План', start: planS, end: planE, cls: 'active' });
    }
    if (factS) {
        rows.push({ label: 'Факт', start: factS, end: factE || new Date(), cls: 'fact' });
    }

    // Строки по папкам-этапам (последнее изменение файла в папке = дата этапа)
    const stageColors = ['#7C3AED','#0891B2','#D97706','#059669','#DC2626'];
    if (p.folders && p.folders.length > 0) {
        const stageFolders = p.folders.filter(f => f.name !== 'Прочее');
        stageFolders.forEach((folder, i) => {
            const files = folder.files || [];
            if (files.length === 0) return;
            const dates = files.map(f => {
                const parts = f.modified.split('.');
                return parts.length === 3 ? new Date(+parts[2], +parts[1]-1, +parts[0]) : null;
            }).filter(Boolean);
            if (dates.length === 0) return;
            const minF = new Date(Math.min(...dates));
            const maxF = new Date(Math.max(...dates));
            const color = stageColors[i % stageColors.length];
            rows.push({ label: folder.name, start: minF, end: maxF, cls: 'stage', color });
        });
    }

    if (rows.length === 0) {
        el.innerHTML = '<div class="gantt-empty">Даты для проекта не указаны</div>';
        return;
    }

    const allDates = rows.flatMap(r => [r.start, r.end]);
    const minD = new Date(Math.min(...allDates));
    const maxD = new Date(Math.max(...allDates));
    minD.setDate(1);
    maxD.setMonth(maxD.getMonth() + 1, 0);
    const totalMs  = maxD - minD || 1;
    const today    = new Date();
    const todayPct = Math.max(0, Math.min(100, (today - minD) / totalMs * 100));

    const months = [];
    const cur = new Date(minD);
    while (cur <= maxD) {
        months.push(cur.toLocaleDateString('ru-RU', { month: 'short', year: '2-digit' }));
        cur.setMonth(cur.getMonth() + 2);
    }

    const axisHtml = `<div class="gantt-axis">${months.map(m => `<span>${m}</span>`).join('')}</div>`;

    const rowsHtml = rows.map(r => {
        const left  = Math.max(0, (r.start - minD) / totalMs * 100);
        const width = Math.min(100 - left, Math.max(2, (r.end - r.start) / totalMs * 100));
        const lbl   = r.start.toLocaleDateString('ru-RU', { month: 'short', year: 'numeric' });
        const colorStyle = r.color ? `background:${r.color}` : '';
        return `
          <div class="gantt-row">
            <div class="gantt-label" title="${r.label}">${r.label}</div>
            <div class="gantt-track">
              <div class="gantt-today" style="left:${todayPct}%" title="Сегодня"></div>
              <div class="gantt-bar ${r.cls}" style="left:${left}%;width:${width}%;${colorStyle}"
                   title="${r.start.toLocaleDateString('ru-RU')} — ${r.end.toLocaleDateString('ru-RU')}">${lbl}</div>
            </div>
          </div>`;
    }).join('');

    const legendHtml = `
      <div class="gantt-legend">
        <div class="gantt-legend-item">
          <div class="gantt-legend-dot" style="background:#2563EB"></div>Плановые сроки
        </div>
        <div class="gantt-legend-item">
          <div class="gantt-legend-dot" style="background:#059669"></div>Фактические сроки
        </div>
        <div class="gantt-legend-item">
          <div class="gantt-legend-dot" style="background:#DC2626;opacity:.7"></div>Сегодня
        </div>
      </div>`;

    el.innerHTML = `<div class="gantt-wrap">${axisHtml}${rowsHtml}</div>${legendHtml}`;
}

