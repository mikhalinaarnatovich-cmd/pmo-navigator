// ════ ПОРТФЕЛЬ — РЕНДЕР ГАНТА ═════════════════════════════════════════════════
function renderPortfolioGantt() {
    const statusFilter   = document.getElementById('pfStatus').value;
    const deptFilter     = document.getElementById('pfDept').value;
    const priorityFilter = document.getElementById('pfPriority').value;
    const customerFilter = document.getElementById('pfCustomer').value;
    const pmFilter       = document.getElementById('pfPM').value;
    const curatorFilter  = document.getElementById('pfCurator').value;
    const onlyActive     = document.getElementById('pfOnlyActive').checked;

    const INACTIVE = ['Завершён', 'Отменён'];

    let list = allProjects.filter(p => {
        if (statusFilter   && p.status         !== statusFilter)   return false;
        if (deptFilter     && p.department      !== deptFilter)     return false;
        if (priorityFilter && p.priority        !== priorityFilter) return false;
        if (customerFilter && p.customer        !== customerFilter) return false;
        if (pmFilter       && p.projectManager  !== pmFilter)       return false;
        if (curatorFilter  && p.curator         !== curatorFilter)  return false;
        if (onlyActive     && INACTIVE.includes(p.status))         return false;
        const hasDate = (p.planStart && p.planStart !== '-') || (p.factStart && p.factStart !== '-');
        return hasDate;
    });

    list = list.slice().sort((a, b) => {
        const da = parseRuDate(a.planStart) || new Date('9999');
        const db = parseRuDate(b.planStart) || new Date('9999');
        return da - db;
    });

    document.getElementById('pfCount').textContent = list.length > 0
        ? `Показано: ${list.length} проектов` : '';

    const container = document.getElementById('portfolioGantt');

    if (list.length === 0) {
        container.innerHTML = '<div class="pg-empty">Нет проектов для отображения.<br>Попробуйте изменить фильтры.</div>';
        return;
    }

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let axisStart, axisEnd;

    if (portfolioScale === 'quarter') {
        const qMonth = Math.floor(today.getMonth() / 3) * 3;
        axisStart = new Date(today.getFullYear(), qMonth, 1);
        axisEnd   = new Date(today.getFullYear(), qMonth + 3, 0);
    } else if (portfolioScale === 'half') {
        const hMonth = Math.floor(today.getMonth() / 6) * 6;
        axisStart = new Date(today.getFullYear(), hMonth, 1);
        axisEnd   = new Date(today.getFullYear(), hMonth + 6, 0);
    } else if (portfolioScale === 'all') {
        // Диапазон по данным: от самой ранней до самой поздней даты в списке
        const allDates = [];
        for (const p of list) {
            const _ps = parseRuDate(p.planStart); if (_ps) allDates.push(_ps);
            const _pe = parseRuDate(p.planEnd);   if (_pe) allDates.push(_pe);
            const _fs = parseRuDate(p.factStart); if (_fs) allDates.push(_fs);
            const _fe = parseRuDate(p.factEnd);   if (_fe) allDates.push(_fe);
        }
        const minTs = Math.min(...allDates.map(d => d.getTime()));
        const maxTs = Math.max(...allDates.map(d => d.getTime()));
        axisStart = new Date(minTs);
        axisStart.setDate(1); // начало месяца
        axisEnd = new Date(maxTs);
        axisEnd.setMonth(axisEnd.getMonth() + 1, 0); // конец месяца
    } else {
        axisStart = new Date(today.getFullYear(), 0, 1);
        axisEnd   = new Date(today.getFullYear(), 11, 31);
    }

    const totalMs = axisEnd - axisStart || 1;

    // Шаг меток оси: для 'all' подбираем автоматически по ширине диапазона
    const rangeMonths = Math.round(totalMs / (1000 * 60 * 60 * 24 * 30));
    const stepMonths = portfolioScale === 'quarter' ? 1
        : portfolioScale === 'half' ? 1
        : portfolioScale === 'all' ? (rangeMonths <= 12 ? 1 : rangeMonths <= 36 ? 3 : rangeMonths <= 72 ? 6 : 12)
        : 2;
    const axisLabels = [];
    const cur = new Date(axisStart);
    cur.setDate(1);
    while (cur <= axisEnd) {
        const pct = (cur - axisStart) / totalMs * 100;
        if (pct >= 0 && pct <= 100) {
            axisLabels.push({
                pct,
                label: cur.toLocaleDateString('ru-RU', { month: 'short', year: (portfolioScale === 'year' || portfolioScale === 'all') ? '2-digit' : 'numeric' })
            });
        }
        cur.setMonth(cur.getMonth() + stepMonths);
    }

    const todayPct = Math.max(0, Math.min(100, (today - axisStart) / totalMs * 100));

    const STATUS_TO_BAR = {
        'Выполнение и контроль': 'pg-active',
        'Планирование':          'pg-plan',
        'Инициация':             'pg-init',
        'На паузе (On-Hold)':    'pg-pause',
        'Завершение':            'pg-finish',
        'Завершён':              'pg-done',
        'Отменён':               'pg-cancel',
        'Утвержден (В бэклоге)': 'pg-backlog',
        'Отложен':               'pg-delay',
    };

    const axisTicksHtml = axisLabels.map(l =>
        `<div class="pg-axis-tick" style="left:${l.pct}%"></div>
         <div class="pg-axis-label" style="left:${l.pct}%">${l.label}</div>`
    ).join('');

    const headerHtml = `
      <div class="pg-header">
        <div class="pg-header-spacer"></div>
        <div class="pg-axis-wrap" id="pgAxisWrap">
          ${axisTicksHtml}
          <div class="pg-today-line" style="left:${todayPct}%" title="Сегодня"></div>
        </div>
      </div>`;

    const rowsHtml = list.map(p => {
        const planS = parseRuDate(p.planStart);
        const planE = parseRuDate(p.planEnd);

        const isDone = INACTIVE.includes(p.status);
        const isOverdue = !isDone && planE && planE < today;

        let barHtml = '';
        if (planS && planE) {
            const left  = (planS - axisStart) / totalMs * 100;
            const right = (planE - axisStart) / totalMs * 100;
            const clampL = Math.max(0, left);
            const clampR = Math.min(100, right);
            if (clampR > clampL) {
                const barCls = isOverdue ? 'pg-overdue' : (STATUS_TO_BAR[p.status] || 'pg-plan');
                const tooltip = `${p.name}\n${fmtDate(p.planStart)} — ${fmtDate(p.planEnd)}\n${p.status}${isOverdue ? '\n⚠ Просрочен' : ''}`;
                barHtml = `<div class="pg-bar ${barCls}"
                    style="left:${clampL}%;width:${clampR - clampL}%"
                    title="${esc(tooltip)}"></div>`;
            }
        }

        const nameStyle = isOverdue ? 'color:#DC2626;font-weight:600' : '';

        return `
          <div class="pg-row" onclick="loadDetail(${p.projectId})" title="Открыть карточку проекта">
            <div class="pg-label-cell">
              <span class="pg-label-id">${p.projectId}</span>
              <span class="pg-label-name" style="${nameStyle}">${esc(p.name)}</span>
            </div>
            <div class="pg-track-cell">
              <div class="pg-track"></div>
              ${barHtml}
              <div class="pg-today-line" style="left:${todayPct}%"></div>
              ${axisLabels.map(l => `<div class="pg-grid-line" style="left:${l.pct}%"></div>`).join('')}
            </div>
          </div>`;
    }).join('');

    container.innerHTML = headerHtml + rowsHtml;
}

