let resourceViewActive = false;
let resourceReferenceLoaded = false;
let resourceProjects = [];

function resourceApiUrl(path = '') {
    const base = `${BASE}api/resource-plan`;
    return path
        ? `${base}/${String(path).replace(/^\/+/, '')}`
        : base;
}

function resourceMonthToApiValue() {
    const value = document.getElementById('resourcePeriod').value;
    if (!value) return '';
    return `${value}-01`;
}

function resourceFormatDate(value) {
    if (!value) return '—';

    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '—';

    return date.toLocaleString('ru-RU', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
}

function resourceEscape(value) {
    return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
}

function resourceShowMessage(text, type) {
    const box = document.getElementById('resourceMessage');
    box.textContent = text;
    box.className = `resource-message show ${type}`;

    window.clearTimeout(resourceShowMessage.timer);
    resourceShowMessage.timer = window.setTimeout(() => {
        box.className = 'resource-message';
    }, 6000);
}

function resourceSetDefaultPeriod() {
    const input = document.getElementById('resourcePeriod');

    if (input.value) return;

    const now = new Date();
    input.value =
        `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
}

let resourceCurrentKind = 'Project';
let resourceEmployees = [];
let resourceOperationalItems = [];
let resourceVacationItems = [];

function resourceSetKind(kind) {
    resourceCurrentKind = kind;
    document.querySelectorAll('.resource-kind-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.kind === kind);
    });

    const showProject = kind === 'Project';
    document.getElementById('resourceProjectField').style.display = showProject ? '' : 'none';
    document.getElementById('resourceActivityField').style.display = showProject ? 'none' : '';

    // Заполняем список активностей для Operational/Vacation
    if (!showProject) {
        const items = kind === 'Operational' ? resourceOperationalItems : resourceVacationItems;
        const sel = document.getElementById('resourceActivity');
        sel.innerHTML = items.map(a =>
            `<option value="${resourceEscape(a.code)}">${resourceEscape(a.name)}</option>`
        ).join('');
        if (items.length > 0) sel.value = items[0].code;
    }
}

async function resourceLoadReference() {
    if (resourceReferenceLoaded) return;

    const response = await fetch(resourceApiUrl('/reference'));
    if (!response.ok) {
        throw new Error('Не удалось загрузить список сотрудников и проектов.');
    }

    const data = await response.json();
    resourceProjects = data.projectItems ?? [];
    resourceEmployees = data.employees ?? [];
    resourceOperationalItems = data.operationalItems ?? [];
    resourceVacationItems = data.vacationItems ?? [];

    const employeeSelect = document.getElementById('resourceEmployee');
    employeeSelect.innerHTML =
        '<option value="">Выберите сотрудника</option>' +
        resourceEmployees
            .map(emp => `<option value="${resourceEscape(emp.name)}">${resourceEscape(emp.name)}</option>`)
            .join('');

    // При выборе сотрудника — обновляем подсказку с лимитом по ставке
    employeeSelect.addEventListener('change', resourceUpdateCapHint);

    const projectSelect = document.getElementById('resourceProject');
    projectSelect.innerHTML =
        '<option value="">Выберите проект</option>' +
        resourceProjects
            .map(project =>
                `<option value="${project.projectId}">` +
                `#${project.projectId} — ${resourceEscape(project.name)}` +
                `</option>`)
            .join('');

    // Заполняем фильтр руководителей (команд)
    const teamSelect = document.getElementById('resourceTeamFilter');
    const managers = [...new Set(
        resourceEmployees
            .filter(e => e.managerFullName)
            .map(e => e.managerFullName)
    )].sort((a,b) => a.localeCompare(b, 'ru'));
    teamSelect.innerHTML = '<option value="">Все сотрудники</option>' +
        managers.map(m => `<option value="${resourceEscape(m)}">${resourceEscape(m)} (моя команда)</option>`).join('');

    resourceReferenceLoaded = true;
}

function resourceUpdateCapHint() {
    const name = document.getElementById('resourceEmployee').value;
    const emp = resourceEmployees.find(e =>
        e.name.toLowerCase() === name.toLowerCase());
    const cap = emp ? emp.capPercent : 100;
    const rate = emp ? emp.rate : 1;
    document.getElementById('resourceCapHint').textContent =
        `лимит: ${cap.toLocaleString('ru-RU')}% (ставка ${rate})`;
}

// При вводе часов — автоматически считаем %
function resourceHoursToPercent() {
    const hours = parseFloat(document.getElementById('resourceHours').value);
    if (!hours || hours <= 0) return;
    // Используем CalendarHoursForMonth из последнего загруженного плана, либо 160 как фолбэк
    const calendarHours = window.resourceCalendarHours || 160;
    const percent = (hours / calendarHours * 100).toFixed(2);
    document.getElementById('resourcePercent').value = percent;
}

function resourceProjectName(projectId) {
    const project = resourceProjects.find(x => x.projectId === projectId);
    return project
        ? `#${project.projectId} — ${project.name}`
        : `#${projectId}`;
}

function resourceRenderPlan(data) {
    window.resourcePlanData = data;

    // Сохраняем норму часов для пересчёта часы→%
    if (data.items && data.items.length > 0 && data.items[0].plannedHours != null) {
        window.resourceCalendarHours = data.items[0].calendarHoursForMonth || 160;
    }

    const summary = document.getElementById('resourceSummary');
    const controlTbody = document.getElementById('resourceControlTbody');

    const items = data.items ?? [];
    const employees = data.employees ?? [];
    const visibleEmployees = resourceOnlyEmpty
        ? employees.filter(e => e.status === "Не заполнил")
        : employees;
    const planSummary = data.summary ?? {
        employeesTotal: 0, filledCount: 0, partialCount: 0, emptyCount: 0
    };

    summary.innerHTML = `
        <div class="resource-total-card">
            <div class="resource-total-name">Всего сотрудников</div>
            <div class="resource-total-value">${planSummary.employeesTotal}</div>
        </div>
        <div class="resource-total-card">
            <div class="resource-total-name">Заполнено (100%)</div>
            <div class="resource-total-value">${planSummary.filledCount}</div>
        </div>
        <div class="resource-total-card">
            <div class="resource-total-name">Частично заполнено</div>
            <div class="resource-total-value">${planSummary.partialCount}</div>
        </div>
        <div class="resource-total-card overload">
            <div class="resource-total-name">Не заполнили</div>
            <div class="resource-total-value">${planSummary.emptyCount}</div>
        </div>
    `;

    if (!visibleEmployees.length) {
        controlTbody.innerHTML =
            '<tr><td class="resource-empty" colspan="6">' +
            'Сотрудники не найдены.' +
            '</td></tr>';
        return;
    }

    controlTbody.innerHTML = visibleEmployees.map(emp => {
        const total = Number(emp.totalPercent);
        const cap = Number(emp.capPercent || 100);
        const rate = Number(emp.rate || 1);
        const statusClass =
            emp.status === 'Заполнено' ? 'full'
            : emp.status === 'Частично заполнено' ? 'partial' : 'empty';

        return `
    <tr class="resource-control-row"
        ondblclick="resourceSelectEmployee('${resourceEscape(emp.employeeName).replace(/'/g, '&#39;')}')"
        title="Двойной клик — заполнить план">
        <td>
            ${resourceEscape(emp.employeeName)}
            <button class="resource-preview-btn" onclick="event.stopPropagation();resourceOpenHistory('${resourceEscape(emp.employeeName).replace(/'/g, '&#39;')}')" title="История">📜</button>
        </td>
        <td style="font-size:12px;color:#6B7280">${resourceEscape(emp.department || '—')} / ${resourceEscape(emp.sector || '—')}</td>
        <td><b>${rate.toLocaleString('ru-RU')}</b></td>
        <td style="font-size:12px;color:#6B7280">${cap.toLocaleString('ru-RU')}%</td>
        <td><b>${total.toLocaleString('ru-RU')}%</b></td>
        <td>
            <span class="resource-status ${statusClass}">${resourceEscape(emp.status)}</span>
        </td>
    </tr>`;
    }).join('');
}

async function resourceLoadPlan() {
    const period = resourceMonthToApiValue();
    if (!period) return;

    const teamFilter = document.getElementById('resourceTeamFilter')?.value || '';
    let url = resourceApiUrl(`?period=${encodeURIComponent(period)}`);
    if (teamFilter) {
        url += `&managerFullName=${encodeURIComponent(teamFilter)}`;
    }

    const response = await fetch(url);
    if (!response.ok) {
        throw new Error('Не удалось загрузить ресурсный план за выбранный месяц.');
    }

    const data = await response.json();
    resourceRenderPlan(data);
}

