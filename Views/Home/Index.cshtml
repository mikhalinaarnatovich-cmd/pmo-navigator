}

.resource-toolbar {
    padding: 14px 20px;
    background: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
    display: flex;
    align-items: end;
    gap: 12px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.resource-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.resource-field label {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
}

.resource-field select,
.resource-field input,
.resource-field textarea {
    border: 1px solid #D1D5DB;
    border-radius: 7px;
    padding: 7px 10px;
    background: #FFFFFF;
    color: #111827;
    font: inherit;
    font-size: 13px;
    outline: none;
}

.resource-field select:focus,
.resource-field input:focus,
.resource-field textarea:focus {
    border-color: #2563EB;
