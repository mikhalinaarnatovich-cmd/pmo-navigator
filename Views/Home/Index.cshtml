async function resourceSave() {
    const employeeName = document.getElementById('resourceEmployee').value;
    const kind = resourceCurrentKind;
    const periodStart = resourceMonthToApiValue();
    const comment = document.getElementById('resourceComment').value.trim();
    const hours = parseFloat(document.getElementById('resourceHours').value) || null;
    const allocationPercent = parseFloat(document.getElementById('resourcePercent').value) || 0;
    const button = document.getElementById('btnResourceSave');

    if (!employeeName) { resourceShowMessage('Выберите сотрудника.', 'error'); return; }
    if (!periodStart) { resourceShowMessage('Выберите месяц.', 'error'); return; }

    let projectId = null;
    let activityName = null;

    if (kind === 'Project') {
        projectId = Number(document.getElementById('resourceProject').value);
        if (!projectId) { resourceShowMessage('Выберите проект.', 'error'); return; }
    } else {
        activityName = document.getElementById('resourceActivity').value;
        if (!activityName) { resourceShowMessage('Выберите активность.', 'error'); return; }
    }

    if (!hours && (!Number.isFinite(allocationPercent) || allocationPercent <= 0)) {
        resourceShowMessage('Введите часы или процент загрузки.', 'error');
        return;
    }

    button.disabled = true;
    button.textContent = 'Сохранение...';

    try {
        const response = await fetch(resourceApiUrl(''), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                employeeName,
                employeeLogin: null,
                kind,
                projectId: projectId || undefined,
                activityName: activityName || undefined,
                periodStart,
                allocationPercent: hours ? 0 : allocationPercent,
                hours: hours,
                comment
            })
        });

        const result = await response.json();

        if (!response.ok) {
            resourceShowMessage(result.message || 'Не удалось сохранить назначение.', 'error');
            return;
        }

        document.getElementById('resourceProject').value = '';
        document.getElementById('resourceActivity').value = '';
        document.getElementById('resourcePercent').value = '';
        document.getElementById('resourceHours').value = '';
        document.getElementById('resourceComment').value = '';

        resourceShowMessage(
            `Сохранено. Итоговая загрузка: ${Number(result.totalPercent).toLocaleString('ru-RU')}%` +
            (result.capPercent ? ` (лимит ${Number(result.capPercent).toLocaleString('ru-RU')}%)` : ''),
            'ok'
        );

        await resourceLoadPlan();
    } catch (error) {
        console.error(error);
        resourceShowMessage('Ошибка соединения при сохранении.', 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Сохранить';
    }
}

async function resourceDeleteAllocation(id) {
    if (!window.confirm('Удалить это назначение?')) return;

    try {
        const response = await fetch(resourceApiUrl(`/${id}`), {
            method: 'DELETE'
        });

        if (!response.ok) {
            resourceShowMessage('Не удалось удалить назначение.', 'error');
            return;
        }

        resourceShowMessage('Назначение удалено.', 'ok');
        await resourceLoadPlan();
    } catch (error) {
        console.error(error);
        resourceShowMessage('Ошибка соединения при удалении.', 'error');
    }
}

