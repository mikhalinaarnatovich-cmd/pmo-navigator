function pkRenderProjectTypeChart() {
    const active = allProjects.filter(p => !['Завершён','Отменён'].includes(p.status));
    const typeMap = {};
    active.forEach(p => {
        const t = p.projectType || 'Не указан';
        typeMap[t] = (typeMap[t] || 0) + 1;
    });
    if (Object.keys(typeMap).length === 0) {
        const canvas = document.getElementById('chartProjectType');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#9CA3AF';
            ctx.font = '14px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Нет данных', canvas.width/2, canvas.height/2);
        }
        const legend = document.getElementById('legendProjectType');
        if (legend) legend.innerHTML = '';
        return;
    }
    const data = Object.entries(typeMap)
        .sort((a,b) => b[1]-a[1])
        .map(([label, value]) => ({ label, value, color: ['#2563EB','#8B5CF6','#10B981','#F59E0B','#EF4444','#06B6D4','#EC4899'][Object.keys(typeMap).indexOf(label) % 7] || '#9CA3AF' }));
    drawDonut('chartProjectType', 'legendProjectType', data);
}

function pkRenderDeptChart() {
    const active = allProjects.filter(p => !['Завершён','Отменён'].includes(p.status));
    const depts = {};
    active.forEach(p => {
        const d = p.department || 'Не указан';
        if (!depts[d]) depts[d] = { total: 0, onPlan: 0, risks: 0, intervention: 0 };
        depts[d].total++;
        const rag = getPKStatus(p);
        if (rag === 'green') depts[d].onPlan++;
        else if (rag === 'yellow') depts[d].risks++;
        else if (rag === 'red') depts[d].intervention++;
    });

    const canvas = document.getElementById('chartByDept');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const entries = Object.entries(depts).sort((a,b) => b[1].total - a[1].total).slice(0, 10);
    if (!entries.length) return;

    const barH = 28, gap = 8, maxW = 300, startX = 160;
    entries.forEach(([dept, counts], i) => {
        const y = i * (barH + gap) + 10;
        ctx.fillStyle = '#374151';
        ctx.font = '11px sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText(dept.length > 20 ? dept.slice(0,18) + '..' : dept, startX - 8, y + barH/2 + 3);

        const totalW = (counts.total / entries[0][1].total) * maxW;
        ctx.fillStyle = '#10B981';
        ctx.fillRect(startX, y, totalW * (counts.onPlan/counts.total), barH);
        ctx.fillStyle = '#F59E0B';
        ctx.fillRect(startX + totalW * (counts.onPlan/counts.total), y, totalW * (counts.risks/counts.total), barH);
        ctx.fillStyle = '#EF4444';
        ctx.fillRect(startX + totalW * ((counts.onPlan+counts.risks)/counts.total), y, totalW * (counts.intervention/counts.total), barH);

        ctx.fillStyle = '#fff';
        ctx.font = 'bold 10px sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(counts.total, startX + totalW + 6, y + barH/2 + 3);
    });
}

function pkRenderScoringChart() {
    const canvas = document.getElementById('chartScoring');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    const pad = 50;
    const plotW = W - pad * 2, plotH = H - pad * 2;

    // Оси
    ctx.strokeStyle = '#E5E7EB';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad, pad);
    ctx.lineTo(pad, H - pad);
    ctx.lineTo(W - pad, H - pad);
    ctx.stroke();

    // Сетка
    ctx.strokeStyle = '#F3F4F6';
    for (let i = 1; i <= 4; i++) {
        const x = pad + (plotW / 4) * i;
        const y = H - pad - (plotH / 4) * i;
        ctx.beginPath();
        ctx.moveTo(pad, y); ctx.lineTo(W - pad, y);
        ctx.moveTo(x, pad)  ; ctx.lineTo(x, H - pad);
        ctx.stroke();
    }

    // Метки осей
    ctx.fillStyle = '#6B7280';
    ctx.font = '11px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Стратегическое соответствение →', W/2, H - 10);
    ctx.save();
    ctx.translate(14, H/2);
    ctx.rotate(-Math.PI/2);
    ctx.fillText('← Сложность и Риски', 0, 0);
    ctx.restore();

    // Точки
    const active = allProjects.filter(p => !['Завершён','Отменён'].includes(p.status));
    const parseScore = s => {
        const v = parseFloat(String(s || '').replace(',', '.'));
        return isNaN(v) ? null : v;
    };

    const scoreData = active.map(p => ({
        p,
        x: parseScore(p.strategicAlignment),
        y: parseScore(p.complexityRisk)
    })).filter(d => d.x !== null && d.y !== null);

    if (scoreData.length === 0) {
        ctx.fillStyle = '#9CA3AF';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Нет данных для скоринга', W/2, H/2);
        ctx.font = '11px sans-serif';
        ctx.fillText('Заполните поля «Сложность и Риски» и «Стратегическое соответствие»', W/2, H/2 + 20);
        return;
    }

    scoreData.forEach(({p, x, y}) => {
        const px = pad + (x / 5) * plotW;
        const py = H - pad - (y / 5) * plotH;

        const rag = getPKStatus(p);
        ctx.fillStyle = rag === 'red' ? '#EF4444' : rag === 'yellow' ? '#F59E0B' : '#10B981';
        ctx.beginPath();
        ctx.arc(px, py, 6, 0, 2*Math.PI);
        ctx.fill();

        // Подпись для красных
        if (rag === 'red') {
            ctx.fillStyle = '#374151';
            ctx.font = '9px sans-serif';
            ctx.textAlign = 'left';
            ctx.fillText('#' + p.projectId, px + 8, py - 4);
        }
    });
}

