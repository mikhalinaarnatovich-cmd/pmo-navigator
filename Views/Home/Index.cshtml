}
function resourceEditAllocation(id) {
    const data = window.resourcePlanData ?? { items: [] };
    const item = (data.items ?? []).find(x => Number(x.id) === Number(id));

    if (!item) {
        resourceShowMessage('Не удалось найти назначение для редактирования.', 'error');
        return;
    }

    document.getElementById('resourceEmployee').value = item.employeeName;
    resourceUpdateCapHint();

    const kind = item.kind || 'Project';
    resourceSetKind(kind);

    if (kind === 'Project' && item.projectId) {
        document.getElementById('resourceProject').value = String(item.projectId);
    } else {
        document.getElementById('resourceActivity').value = item.activityName || '';
    }

    document.getElementById('resourcePercent').value = item.allocationPercent;
    document.getElementById('resourceHours').value = item.plannedHours || '';
    document.getElementById('resourceComment').value = item.comment || '';

    resourceClosePerson();

    document.querySelector('.resource-toolbar')
        .scrollIntoView({ behavior: 'smooth', block: 'start' });

    window.setTimeout(() => {
        document.getElementById('resourcePercent').focus();
        document.getElementById('resourcePercent').select();
    }, 350);
}

async function resourceDeleteFromPanel(id) {
    if (!confirm('Удалить это назначение?')) return;

    await resourceDeleteAllocation(id);

    const panel = document.getElementById('resourcePersonPanel');
