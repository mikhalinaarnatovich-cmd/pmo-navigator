function pkSort(field) {
    if (pkSortField === field) {
        pkSortDir = pkSortDir === 'asc' ? 'desc' : 'asc';
    } else {
        pkSortField = field;
        pkSortDir = 'asc';
    }
    // Обновляем индикаторы в заголовках
    ['name','score'].forEach(f => {
        const el = document.getElementById(`pkSort${f.charAt(0).toUpperCase()+f.slice(1)}`);
        if (el) el.textContent = pkSortField === f ? (pkSortDir === 'asc' ? '↑' : '↓') : '↕';
    });
    renderPKTable();
}

// Нормализация healthStatus → 'red' | 'yellow' | 'green' | null
function normalizeHealth(healthStatus) {
    const h = (healthStatus || '').trim().toLowerCase()
        .replace(/ё/g, 'е').replace(/й/g, 'и');
    if (h.includes('красн')) return 'red';
    if (h.includes('желт') || h.includes('жолт')) return 'yellow';
    if (h.includes('зелен') || h.includes('зел')) return 'green';
    return null;
}

function getPKStatus(p) {
    const INACTIVE = ['Завершён', 'Отменён'];
    if (INACTIVE.includes(p.status)) return null;

    // RAG из поля CSV
    const fromHealth = normalizeHealth(p.healthStatus);
    if (fromHealth) return fromHealth;

    // Фоллбэк по дате если поле пустое
    const today = new Date(); today.setHours(0,0,0,0);
    const dateStr = (p.deadlineDate && p.deadlineDate !== '-') ? p.deadlineDate : p.planEnd;
    if (!dateStr || dateStr === '-') return 'green';
    const d = parseRuDate(dateStr);
    if (!d) return 'green';
    const diff = Math.ceil((d - today) / 86400000);
    if (diff < 0) return 'red';
    if (diff <= 30) return 'yellow';
    return 'green';
}

