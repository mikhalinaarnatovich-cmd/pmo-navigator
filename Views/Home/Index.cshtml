function buildPKCustomerFilter() {
    const sel = document.getElementById('pkFilterCustomer');
    const current = sel.value;
    sel.innerHTML = '<option value="">Все</option>';
    const pkList = allProjects.filter(p => getPKStatus(p) !== null);
    const customers = [...new Set(pkList.map(p => p.customer).filter(v => v && v !== '-'))].sort((a,b) => a.localeCompare(b,'ru'));
    for (const c of customers) {
        const opt = document.createElement('option');
        opt.value = c; opt.textContent = c;
        sel.appendChild(opt);
    }
    if (current) sel.value = current;
}

function renderPKTable() {
    // Построить фильтр заказчиков при первом рендере
    buildPKCustomerFilter();

    const statusFilter   = document.getElementById('pkFilterStatus').value;
    const customerFilter = document.getElementById('pkFilterCustomer').value;
    const searchVal      = (document.getElementById('pkSearch')?.value || '').trim().toLowerCase();

    const INACTIVE = ['Завершён', 'Отменён'];

    // Фильтруем: только активные (не Завершён/Отменён)
    let list = allProjects.filter(p => {
        const rag = getPKStatus(p);
        if (rag === null) return false;
        if (statusFilter && rag !== statusFilter) return false;
        if (customerFilter && p.customer !== customerFilter) return false;
        if (searchVal) {
            const inId   = String(p.projectId).includes(searchVal);
            const inName = (p.name || '').toLowerCase().includes(searchVal);
            if (!inId && !inName) return false;
        }
        return true;
    });

    // Сортировка
    const RAG_ORDER = { red: 0, yellow: 1, green: 2 };
    list = list.slice().sort((a, b) => {
        if (pkSortField === 'name') {
            const cmp = (a.name || '').localeCompare(b.name || '', 'ru');
            return pkSortDir === 'asc' ? cmp : -cmp;
        }
        if (pkSortField === 'score') {
            const sa = parseFloat((a.totalScore || '').replace(',','.')) || 0;
            const sb = parseFloat((b.totalScore || '').replace(',','.')) || 0;
            // desc = высокий вверху
            return pkSortDir === 'desc' ? sb - sa : sa - sb;
        }
        // по умолчанию: по RAG
        const ra = RAG_ORDER[getPKStatus(a)] ?? 3;
        const rb = RAG_ORDER[getPKStatus(b)] ?? 3;
        return ra - rb;
    });

    document.getElementById('pkCount').textContent = `Показано: ${list.length} проектов`;

    const tbody = document.getElementById('pkTbody');

    if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:40px;color:#9CA3AF">Проектов не найдено</td></tr>`;
        return;
    }

    tbody.innerHTML = list.map(p => {
        const rag = getPKStatus(p);
        const rowCls = rag === 'red' ? 'pk-row-red' : rag === 'yellow' ? 'pk-row-yellow' : '';

        // RAG-кружок
        const ragDotCls = rag === 'red' ? 'rag-red' : rag === 'yellow' ? 'rag-yellow' : 'rag-green';
        const ragCell = `<div class="rag-cell"><span class="rag-dot ${ragDotCls}"></span></div>`;

        // Тип обязательств
        const obligType = (p.hardDeadline && p.hardDeadline !== '-' && p.hardDeadline.toLowerCase() !== 'нет')
            ? 'Твёрдое' : 'Прогнозный';

        // Срок завершения
        const deadlineDateStr = (p.deadlineDate && p.deadlineDate !== '-') ? p.deadlineDate : p.planEnd;
        const deadlineFormatted = fmtDate(deadlineDateStr);

        // Скоринг
        const scoreVal = parseFloat(p.totalScore);
        const scoreHtml = !isNaN(scoreVal)
            ? `<span class="score-badge ${scoreVal >= 3 ? 'score-high' : scoreVal >= 2 ? 'score-mid' : 'score-low'}">${p.totalScore}</span>`
            : '<span style="color:#9CA3AF">—</span>';

        // Комментарий
        const commentText = pkComments[p.projectId] || '';
        const commentHtml = buildCommentHtml(p.projectId, commentText);

        return `<tr class="${rowCls}" data-pid="${p.projectId}">
          <td style="cursor:pointer" onclick="loadDetail(${p.projectId})">
            <div class="p-name" style="font-size:12px">${esc(p.name)}</div>
            <div class="p-dept">№ ${p.projectId}</div>
          </td>
          <td>
            <div style="font-size:12px">${esc(p.customer || '—')}</div>
            ${p.projectManager ? `<div class="p-dept">${esc(p.projectManager)}</div>` : ''}
          </td>
          <td>${ragCell}</td>
          <td style="font-size:12px">${obligType}</td>
          <td style="font-size:12px;white-space:nowrap">${deadlineFormatted}</td>
          <td>${scoreHtml}</td>
          <td style="font-size:12px;color:#9CA3AF;text-align:center">—</td>
          <td class="pk-comment-cell">${commentHtml}</td>
        </tr>`;
    }).join('');
}

// ════ ПК — INLINE РЕДАКТИРОВАНИЕ КОММЕНТАРИЯ ══════════════════════════════════
function buildCommentHtml(projectId, text) {
    const displayText = text ? esc(text) : 'Добавить комментарий...';
    const emptyCls = text ? '' : 'empty';
    return `
      <div class="pk-comment-view-${projectId}">
        <span class="pk-comment-text ${emptyCls}" onclick="startEditComment(${projectId})">${displayText}</span>
      </div>
      <div class="pk-comment-edit" id="pk-comment-edit-${projectId}">
        <textarea id="pk-comment-ta-${projectId}" rows="3">${esc(text)}</textarea>
        <div class="pk-comment-actions">
          <button class="pk-comment-save" onclick="commitComment(${projectId})">Сохранить</button>
          <button class="pk-comment-cancel" onclick="cancelEditComment(${projectId})">Отмена</button>
        </div>
      </div>`;
}

function startEditComment(projectId) {
    // Скрыть отображение, показать редактирование
    const viewEl = document.querySelector(`.pk-comment-view-${projectId}`);
    const editEl = document.getElementById(`pk-comment-edit-${projectId}`);
    if (viewEl) viewEl.style.display = 'none';
    if (editEl) editEl.classList.add('active');
    const ta = document.getElementById(`pk-comment-ta-${projectId}`);
    if (ta) { ta.focus(); ta.selectionStart = ta.selectionEnd = ta.value.length; }
}

function cancelEditComment(projectId) {
    const viewEl = document.querySelector(`.pk-comment-view-${projectId}`);
    const editEl = document.getElementById(`pk-comment-edit-${projectId}`);
    if (viewEl) viewEl.style.display = '';
    if (editEl) editEl.classList.remove('active');
    // Вернуть текст textarea к сохранённому
    const ta = document.getElementById(`pk-comment-ta-${projectId}`);
    if (ta) ta.value = pkComments[projectId] || '';
}

async function commitComment(projectId) {
    const ta = document.getElementById(`pk-comment-ta-${projectId}`);
    if (!ta) return;
    const newText = ta.value.trim();
    const ok = await savePKComment(projectId, newText);
    if (ok) {
        // Обновить отображение в ячейке
        const viewEl = document.querySelector(`.pk-comment-view-${projectId}`);
        const editEl = document.getElementById(`pk-comment-edit-${projectId}`);
        if (viewEl) {
            const span = viewEl.querySelector('.pk-comment-text');
            if (span) {
                if (newText) {
                    span.textContent = newText;
                    span.classList.remove('empty');
                } else {
                    span.textContent = 'Добавить комментарий...';
                    span.classList.add('empty');
                }
            }
            viewEl.style.display = '';
        }
        if (editEl) editEl.classList.remove('active');
    } else {
        alert('Не удалось сохранить комментарий. Проверьте соединение.');
    }
}

// ════ ОТКРЫТИЕ ФАЙЛА ═════════════════════════════════════════════════════════
function openFile(path) {
    const ext = path.split('.').pop().toLowerCase();
    const previewable = ['pdf','png','jpg','jpeg','gif','bmp','svg','txt','csv','mp4','webm'];

    if (previewable.includes(ext)) {
        // Превью в модальном окне без скачивания копии
        const modal = document.getElementById('filePreviewModal');
        const iframe = document.getElementById('filePreviewIframe');
        const nameEl = document.getElementById('filePreviewName');
        const dlLink = document.getElementById('filePreviewDownload');

        nameEl.textContent = path.split(/[\\/]/).pop();
        dlLink.href = BASE + '/api/file/download?path=' + encodeURIComponent(path);
        iframe.src = BASE + '/api/file/preview?path=' + encodeURIComponent(path);
        modal.classList.add('open');
    } else {
        // Неподдерживаемый тип — скачиваем
        window.open(BASE + '/api/file/download?path=' + encodeURIComponent(path), '_blank');
    }
}

// ════ УТИЛИТЫ ════════════════════════════════════════════════════════════════
function esc(s) {
    if (!s) return '';
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// Парсинг даты dd.MM.yyyy или ISO
function parseRuDate(d) {
    if (!d || d === '-') return null;
    // dd.MM.yyyy
    const m = d.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
    if (m) return new Date(+m[3], +m[2]-1, +m[1]);
    // ISO yyyy-MM-dd
    const iso = new Date(d);
    return isNaN(iso) ? null : iso;
}

function fmtDate(d) {
    if (!d || d === '-') return '—';
    const dt = parseRuDate(d);
    if (!dt) return d;
    return dt.toLocaleDateString('ru-RU', { day:'2-digit', month:'2-digit', year:'numeric' });
}

function formatDateRange(start, end) {
    const s = fmtDate(start), e = fmtDate(end);
    if (s === '—' && e === '—') return '—';
    if (s === '—') return e;
    if (e === '—') return s;
    return `${s} — ${e}`;
}

const STATUS_CLASSES = {
    'Выполнение и контроль':'s-active','На паузе (On-Hold)':'s-pause',
    'Завершён':'s-done','Отменён':'s-cancel','Инициация':'s-init',
    'Планирование':'s-plan','Утвержден (В бэклоге)':'s-backlog',
    'Завершение':'s-finish','Отложен':'s-delay',
};

function statusBadge(s) {
    return `<span class="badge ${STATUS_CLASSES[s]||'s-done'}">${esc(s||'—')}</span>`;
}

const PRIO_CLASSES = {
    '0 Срочно':'prio-0','1 Высокий':'prio-1',
    '2 Средний':'prio-2','3 Обычный':'prio-3','4 Низкий':'prio-4',
};

function priorityHtml(p) {
    if (!p || p === '-') return '<span style="color:#D1D5DB">—</span>';
    return `<span class="${PRIO_CLASSES[p]||'prio-3'}">${esc(p)}</span>`;
}

function initials(name) {
    if (!name) return '?';
    const parts = name.trim().split(/\s+/);
    return ((parts[0] && parts[0][0]) || '') + ((parts[1] && parts[1][0]) || '');
}

// ════ ЗАПРОСЫ НА ИЗМЕНЕНИЕ ════════════════════════════════════════════════════
// CR = Change Requests. Ищем документы из папки "Запрос на изменение" по ProjectsBasePath
// через уже существующий /api/file/list или через детальный API проекта.
// Так как прямого списочного API нет, собираем данные из уже загруженных проектов
// и для каждого дёргаем /api/projects/{id} чтобы получить список файлов.
// Кэшируем результат в crDocs чтобы не повторять запросы.

let crDocs = null; // [{projectId, projectName, fileName, filePath, modified, folder}]

async function loadCRDocs() {
    if (crDocs !== null) return;
    const INACTIVE = ['Завершён', 'Отменён'];
    // Берём все проекты (включая завершённые — ЗНИ могут быть везде)
    const list = allProjects;
    const results = [];
    // Загружаем детали параллельно пачками по 10
    const BATCH = 10;
    for (let i = 0; i < list.length; i += BATCH) {
        const batch = list.slice(i, i + BATCH);
        const details = await Promise.all(
            batch.map(p =>
                fetch(BASE + `/api/projects/${p.projectId}`)
                    .then(r => r.ok ? r.json() : null)
                    .catch(() => null)
            )
        );
        for (const d of details) {
            if (!d || !d.folders) continue;
            for (const folder of d.folders) {
                const fn = (folder.name || '').toLowerCase();
                if (!fn.includes('запрос') && !fn.includes('изменени')) continue;
                for (const file of (folder.files || [])) {
                    results.push({
                        projectId:   d.projectId,
                        projectName: d.name,
                        fileName:    file.name,
                        filePath:    file.path,
                        modified:    file.modified || '',
                        folder:      folder.name,
                    });
                }
            }
        }
    }
    crDocs = results;
}

function buildCRProjectFilter() {
    const sel = document.getElementById('crFilterProject');
    const current = sel.value;
    sel.innerHTML = '<option value="">Все проекты</option>';
    if (!crDocs) return;
    const projects = [...new Map(crDocs.map(d => [d.projectId, d.projectName])).entries()]
        .sort((a, b) => a[1].localeCompare(b[1], 'ru'));
    for (const [id, name] of projects) {
        const o = document.createElement('option');
        o.value = id; o.textContent = `${id} — ${name}`;
        sel.appendChild(o);
    }
    if (current) sel.value = current;
}

function renderCRTable() {
    const tbody  = document.getElementById('crTbody');
    const filter = document.getElementById('crFilterProject').value;

    if (!crDocs) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;color:#9CA3AF">Загрузка...</td></tr>`;
        loadCRDocs().then(() => { buildCRProjectFilter(); renderCRTable(); });
        return;
    }

    let list = crDocs;
    if (filter) list = list.filter(d => String(d.projectId) === String(filter));

    document.getElementById('crCount').textContent = `Документов: ${list.length}`;

    if (list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:40px;color:#9CA3AF">Документов не найдено</td></tr>`;
        return;
    }

    // Сортировка: по дате изменения убывающей
    list = list.slice().sort((a, b) => {
        if (!a.modified && !b.modified) return 0;
        if (!a.modified) return 1;
        if (!b.modified) return -1;
        return b.modified.localeCompare(a.modified);
    });

    const extIcon = name => {
        const ext = (name.split('.').pop() || '').toLowerCase();
        const colors = { docx:'#2563EB', doc:'#2563EB', xlsx:'#16A34A', xls:'#16A34A',
                         pdf:'#DC2626', pptx:'#D97706', ppt:'#D97706', txt:'#6B7280' };
        const c = colors[ext] || '#6B7280';
        return `<span style="display:inline-block;background:${c};color:#fff;font-size:10px;font-weight:700;padding:2px 5px;border-radius:4px;min-width:32px;text-align:center">${ext.toUpperCase()}</span>`;
    };

    const fmtMod = s => {
        if (!s) return '—';
        const d = new Date(s);
        if (isNaN(d)) return s;
        return d.toLocaleDateString('ru-RU', {day:'2-digit', month:'2-digit', year:'numeric'});
    };

    tbody.innerHTML = list.map(d => `
        <tr onclick="loadDetail(${d.projectId})">
          <td style="font-weight:600;color:#6B7280">${d.projectId}</td>
          <td style="font-size:12px">${esc(d.projectName)}</td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              ${extIcon(d.fileName)}
              <span style="font-size:12px">${esc(d.fileName)}</span>
            </div>
          </td>
          <td style="font-size:12px;color:#6B7280">${esc(d.folder)}</td>
          <td style="font-size:12px;white-space:nowrap">${fmtMod(d.modified)}</td>
          <td>
            <button class="cr-open-btn" onclick="event.stopPropagation();openFile('${esc(d.filePath)}')">Открыть</button>
          </td>
        </tr>`).join('');
}
