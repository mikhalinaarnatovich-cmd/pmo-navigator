    ].filter(d => d.value > 0);
    drawDonut('chartHealth', 'legendHealth', healthData);

    // 2. Статус проекта
    const statusMap = {};
    active.forEach(p => { statusMap[p.status] = (statusMap[p.status] || 0) + 1; });
